/* pages/task/detail/detail.wxss */
.container {
  min-height: 100vh;
  background-color: #FFE6A8;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

/* 创建模式样式 */
.form-item {
  margin-bottom: 40rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: bold;
}

.title-input {
  width: 100%;
  height: 80rpx;
  font-size: 32rpx;
  font-weight: 400;
}

.dishes-list {
  margin-top: 40rpx;
}


.create-btn {
  margin-bottom: 100rpx;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
  padding-top: 40rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
}

.share-code {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  background-color: rgba(255, 255, 255, 0.2);
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  margin: 0 auto;
  width: fit-content;
}

.content {
  width: 90%;
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 38rpx;
  padding: 66rpx 66rpx 40rpx 66rpx;
  margin-top: 36rpx;
  margin-bottom: 40rpx;
  align-self: center;
  box-sizing: border-box;
  position: relative;
  /* content 卡片保持稳定，不添加过渡效果，避免闪烁 */
}

/* 任务状态显示（右上角） */
.content .task-status-wrapper {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  z-index: 10;
}

.content .task-status {
  padding: 8rpx 20rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
}

.content .task-status.active {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  background-color: transparent;
}

.content .task-status.finished {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  background-color: transparent;
}

.content .task-status-icon {
  width: 166rpx;
  height: 166rpx;
  margin-right: 36rpx;
}


.participants-section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.participants-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.participant-item {
  display: flex;
  align-items: center;
  gap: 40rpx;
  /* 添加平滑过渡效果 */
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.participant-avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
}

.participant-info {
  flex: 1;
}

.participant-name {
  display: block;
  font-size: 46rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 10rpx;
}

.participant-role {
  display: block;
  font-size: 28rpx;
  color: #999;
}

.participant-dishes {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.dish-item {
  font-size: 24rpx;
  color: #666;
  background-color: #f0f0f0;
  padding: 5rpx 26rpx;
  border-radius: 15rpx;
}

.add-dish-section {
  margin-bottom: 40rpx;
  padding-top: 40rpx;
  border-top: 1rpx solid #e0e0e0;
}

.dishes-input {
  display: flex;
  gap: 20rpx;
  align-items: center;
  margin-bottom: 30rpx;
}

.input {
  flex: 1;
  height: 80rpx;
  padding: 0 20rpx;
  background-color: #f5f5f5;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: 400;
  color: #333;
  box-sizing: border-box;
}

.add-btn {
  width: 120rpx !important;
  min-width: 120rpx;
  max-width: 120rpx;
  height: 80rpx;
  background-color: #07c160;
  color: #fff;
  border-radius: 10rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  line-height: 1;
}

.add-btn::after {
  border: none;
}

.my-dishes {
  margin-top: 0;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.all-dishes-section {
  margin-top: 40rpx;
  padding-top: 40rpx;
  border-top: 1rpx solid #e0e0e0;
}

.my-dishes-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.dish-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.participants-avatars-section {
  margin-top: 40rpx;
  padding-top: 40rpx;
  border-top: 1rpx solid #e0e0e0;
}

.participants-avatars {
  display: flex;
  align-items: center;
  gap: -10rpx;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.participant-avatar-small {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #fff;
  background-color: #f0f0f0;
  margin-left: -10rpx;
}

.participant-avatar-small:first-child {
  margin-left: 0;
}

.dish-tag {
  display: flex;
  align-items: flex-start;
  background-color: #f0f0f0;
  border-radius: 66rpx;
  padding: 18rpx 32rpx;
  font-size: 26rpx;
  max-width: 100%;
  box-sizing: border-box;
}

.dish-name {
  color: #333;
  margin-right: 10rpx;
  word-break: break-all;
  word-wrap: break-word;
  overflow-wrap: anywhere; /* 更激进的换行策略，可以在任意位置换行 */
  white-space: normal;
  max-width: 100%;
  overflow: hidden;
  flex: 1 1 auto;
  min-width: 0;
  display: block;
  /* 强制换行，即使是特殊字符 */
  line-break: anywhere;
  hyphens: auto;
}

.dish-remove {
  color: #999;
  font-size: 32rpx;
  line-height: 1;
  cursor: pointer;
}

.actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  width:90%;
  max-width: 100%;
  box-sizing: border-box;
  margin-bottom: 40rpx;
  /* 初始状态：隐藏 */
  opacity: 0;
  transform: translateY(20rpx);
}

/* 当 actions 显示时，添加动画类 */
.actions.animate-in {
  animation: actionsSlideIn 0.4s ease-out forwards;
}

@keyframes actionsSlideIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 共用图标样式 - 同时适用于 button 和 view */
.icon-wrapper,
button.icon-wrapper,
view.icon-wrapper {
  position: relative;
  display: flex !important;
  align-items: center;
  justify-content: center;
  width: 215rpx !important;
  height: 215rpx !important;
  min-width: 215rpx !important;
  min-height: 215rpx !important;
  max-width: 215rpx !important;
  max-height: 215rpx !important;
  margin: 0 auto !important;
  transition: transform 0.1s ease;
  padding: 0 !important;
  background: transparent !important;
  background-color: transparent !important;
  border: none !important;
  border-radius: 0 !important;
  line-height: 1 !important;
  box-sizing: border-box !important;
  flex-shrink: 0;
  font-size: 0 !important;
  overflow: visible;
  color: transparent !important;
}

/* button 标签特殊重置 */
button.icon-wrapper {
  /* 重置所有可能的 button 默认样式 */
  appearance: none !important;
  -webkit-appearance: none !important;
  text-align: center !important;
}

.icon-wrapper::after {
  border: none !important;
  display: none !important;
  content: none !important;
}

.icon-image {
  width: 144rpx !important;
  height: 144rpx !important;
  transition: transform 0.1s ease;
  display: block;
  flex-shrink: 0;
}

/* 按下状态 */
.icon-wrapper.pressed {
  transform: scale(0.9);
}

.icon-wrapper.pressed .icon-image {
  transform: scale(0.95);
}

/* 随机选择进行中动画 */
.icon-wrapper.randoming {
  animation: randomPulse 1.5s ease-in-out infinite;
}

@keyframes randomPulse {
  0%, 100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.1);
    opacity: 0.8;
  }
}


/* 选中结果展示区域 */
.result-section {
  margin-top: 40rpx;
  padding: 40rpx;
  background: linear-gradient(135deg, #fff9e6 0%, #fff5d6 100%);
  border-radius: 20rpx;
  border: 2rpx solid #ffd700;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.result-section-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.result-section-icon {
  width: 60rpx;
  height: 60rpx;
  animation: iconRotate 2s ease-in-out infinite;
}

.result-section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.result-section-content {
  text-align: center;
  padding: 30rpx 20rpx;
  border-top: 2rpx solid rgba(255, 215, 0, 0.3);
  border-bottom: 2rpx solid rgba(255, 215, 0, 0.3);
  box-sizing: border-box;
  width: 100%;
}

.result-section-dish {
  font-size: 56rpx;
  font-weight: bold;
  color: #d4af37;
  display: block;
  text-shadow: 0 2rpx 8rpx rgba(212, 175, 55, 0.3);
  animation: dishPulse 2s ease-in-out infinite;
  word-break: break-all;
  word-wrap: break-word;
  overflow-wrap: anywhere; /* 更激进的换行策略，可以在任意位置换行 */
  white-space: normal;
  max-width: 100%;
  overflow: hidden;
  box-sizing: border-box;
  width: 100%;
  /* 强制换行，即使是特殊字符 */
  line-break: anywhere;
  hyphens: auto;
}

/* 随机选择结果遮罩和卡片 */
.result-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  opacity: 0;
  pointer-events: none;
  transition: background-color 0.3s ease, opacity 0.3s ease;
}

.result-mask.show {
  background-color: rgba(0, 0, 0, 0.6);
  opacity: 1;
  pointer-events: auto;
}

.result-card-animated {
  background-color: #fff;
  border-radius: 38rpx;
  padding: 80rpx 60rpx;
  width: 75%;
  max-width: 600rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
  transform: scale(0.8) translateY(50rpx);
  opacity: 0;
  transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.4s ease;
}

.result-mask.show .result-card-animated {
  transform: scale(1) translateY(0);
  opacity: 1;
}

.result-card-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.result-card-title-icon {
  width: 120rpx;
  height: 120rpx;
  display: block;
  margin: 0 auto;
  animation: iconRotate 2s ease-in-out infinite;
}

.result-card-content {
  text-align: center;
  margin-bottom: 40rpx;
  padding: 40rpx 0;
  border-top: 2rpx solid rgba(0, 0, 0, 0.1);
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.1);
}

.result-card-dish {
  font-size: 64rpx;
  font-weight: bold;
  color: #333;
  display: block;
  animation: dishPulse 2s ease-in-out infinite;
}

.result-card-footer {
  text-align: center;
}

.result-card-tip {
  font-size: 24rpx;
  color: #999;
}

@keyframes dishPulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}

@keyframes iconRotate {
  0%, 100% {
    transform: rotate(0deg);
  }
  25% {
    transform: rotate(-10deg);
  }
  75% {
    transform: rotate(10deg);
  }
}

/* 阻止事件冒泡 - 小程序中 catchtap 会自动阻止冒泡 */

/* 订阅消息开关样式 */
.subscribe-switch-section {
  width: 90%;
  margin: 0 auto 30rpx auto;
  align-self: center;
  box-sizing: border-box;
  flex-shrink: 0;
}

.subscribe-switch-content {
  width: 100%;
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 30rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.subscribe-switch-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  margin-right: 30rpx;
}

.subscribe-switch-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.subscribe-switch-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.4;
}

.subscribe-switch {
  flex-shrink: 0;
  transform: scale(1.1);
}

/* Tips 提示样式 */
.tips-section {
  width: 90%;
  margin: 0 auto 40rpx auto;
  align-self: center;
  box-sizing: border-box;
  flex-shrink: 0;
  /* 初始状态：隐藏 */
  opacity: 0;
  transform: translateY(-20rpx);
}

/* 当 tips-section 显示时，添加动画类（淡入效果） */
.tips-section.animate-in {
  animation: tipsSlideIn 0.4s ease-out forwards;
}

@keyframes tipsSlideIn {
  from {
    opacity: 0;
    transform: translateY(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.tips-content {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 20rpx 0;
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 38rpx;
  position: relative;
  overflow: visible;
}

.tips-image {
  width: 100%;
  height: auto;
  max-width: 100%;
  display: block;
  min-height: 200rpx;
  box-sizing: border-box;
  pointer-events: none;
}

.tips-share-overlay {
  position: absolute !important;
  top: 0 !important;
  left: 0 !important;
  width: 100% !important;
  height: 100% !important;
  margin: 0 !important;
  padding: 0 !important;
  border: none !important;
  background: transparent !important;
  z-index: 999 !important;
  pointer-events: auto !important;
  cursor: pointer !important;
  appearance: none !important;
  -webkit-appearance: none !important;
  /* 完全透明但可以点击，不会影响图片显示 */
  opacity: 0 !important;
  /* 使用 min-height 确保可以点击 */
  min-height: 1px !important;
}

.tips-share-overlay::after {
  border: none;
}

.tips-share-overlay.pressed {
  background: rgba(0, 0, 0, 0.05);
}

