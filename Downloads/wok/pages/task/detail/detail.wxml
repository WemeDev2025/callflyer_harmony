<!--pages/task/detail/detail.wxml-->
<view class="container">

  <!-- 统一的卡片内容 -->
  <view class="content">
    <!-- 参与者列表 - 显示创建者（创建模式显示当前用户，详情模式显示任务创建者） -->
    <view class="participants-section">
      <view class="participants-list">
        <!-- 创建模式：显示当前用户 -->
        <view class="participant-item" wx:if="{{mode === 'create' && currentUserInfo}}">
          <image class="participant-avatar" src="{{currentUserInfo.avatar_url || ''}}" mode="aspectFill"></image>
          <view class="participant-info">
            <text class="participant-name">{{currentUserInfo.nickname || '未设置昵称'}}</text>
            <text class="participant-role">发起者</text>
          </view>
        </view>
        <!-- 详情模式：显示任务创建者（只显示第一个，确保只有一个） -->
        <view class="participant-item" wx:elif="{{mode === 'detail' && taskInfo.creatorOnly && taskInfo.creatorOnly.length > 0}}">
          <image class="participant-avatar" src="{{taskInfo.creatorOnly[0].avatar_url || taskInfo.creatorOnly[0].avatarUrl || ''}}" mode="aspectFill"></image>
          <view class="participant-info">
            <text class="participant-name">{{taskInfo.creatorOnly[0].nickname || '未设置昵称'}}</text>
            <text class="participant-role">发起者</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 任务标题 -->
    <view class="form-item">
      <text class="label">纠结啥</text>
      <!-- 统一的输入框，通过属性控制行为 -->
      <input 
        class="input title-input" 
        type="text" 
        placeholder="{{mode === 'create' ? placeholders[placeholderIndex] : ''}}" 
        value="{{mode === 'create' ? title : taskInfo.title}}"
        bindinput="onTitleInput"
        disabled="{{mode === 'detail'}}"
        maxlength="50"
      />
    </view>

    <!-- 添加菜品区域 -->
    <view class="add-dish-section" wx:if="{{mode === 'create' || (mode === 'detail' && taskInfo.status !== 'finished' && !taskInfo.selectedDish && !selectedDishResult)}}">
      <view class="section-title">
        <text>备选项</text>
      </view>
      <!-- 创建模式显示输入框，或者详情模式中：
           1. 从分享页进入（fromShare=true）且任务进行中
           2. 已参与任务（hasParticipated=true）且任务进行中 -->
      <view class="dishes-input" wx:if="{{mode === 'create' || (mode === 'detail' && taskInfo.status !== 'finished' && !taskInfo.selectedDish && (fromShare || hasParticipated))}}">
        <input 
          class="input" 
          type="text" 
          placeholder="{{mode === 'create' ? dishPlaceholders[dishPlaceholderIndex] : '输入想吃的菜品'}}" 
          value="{{currentDish}}"
          bindinput="onDishInput"
          bindconfirm="addDish"
          confirm-type="done"
          maxlength="50"
        />
        <button class="add-btn" bindtap="addDish">添加</button>
      </view>
      <!-- 创建模式：显示已添加的菜品 -->
      <view class="my-dishes" wx:show="{{mode === 'create' && dishes.length > 0}}">
        <view class="dish-tags">
          <view class="dish-tag" wx:for="{{dishes}}" wx:key="index">
            <text class="dish-name">{{item}}</text>
            <text class="dish-remove" bindtap="removeDish" data-index="{{index}}">×</text>
          </view>
        </view>
      </view>
      <!-- 详情模式：显示所有参与者的菜品（合并显示） -->
      <view class="my-dishes" wx:show="{{mode === 'detail' && allDishes && allDishes.length > 0}}">
        <view class="dish-tags">
          <view class="dish-tag" wx:for="{{allDishes}}" wx:key="*this">
            <text class="dish-name">{{item}}</text>
            <text class="dish-remove" bindtap="removeDish" data-dish="{{item}}" wx:if="{{taskInfo.status !== 'finished' && myDishes.includes(item)}}">×</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 详情模式特有内容 -->
    <block wx:show="{{mode === 'detail'}}">
      <!-- 参与者头像（不包含创建者） -->
      <view class="participants-avatars-section" wx:if="{{taskInfo.otherParticipants && taskInfo.otherParticipants.length > 0}}">
        <view class="section-title">
          <text>参与者</text>
        </view>
        <view class="participants-avatars">
          <image 
            class="participant-avatar-small" 
            wx:for="{{taskInfo.otherParticipants}}" 
            wx:key="openid"
            wx:for-item="participant"
            src="{{participant.avatar_url || participant.avatarUrl || ''}}" 
            mode="aspectFill"
          ></image>
        </view>
      </view>

      <!-- 选中结果展示区域 -->
      <view class="result-section" wx:if="{{taskInfo.selectedDish || selectedDishResult}}">
        <view class="result-section-header">
          <image class="result-section-icon" src="/images/icon_great.png" mode="aspectFit"></image>
          <text class="result-section-title">天选答案</text>
        </view>
        <view class="result-section-content">
          <text class="result-section-dish">{{taskInfo.selectedDish || selectedDishResult}}</text>
        </view>
      </view>
    </block>
  </view>

  <!-- Tips 提示 -->
  <view class="tips-section {{showTipsAnimation ? 'animate-in' : ''}}" wx:if="{{mode === 'detail' && isCreator === true && taskInfo.status !== 'finished' && !taskInfo.selectedDish}}">
    <view class="tips-content">
      <image class="tips-icon" src="/images/icon_tips.png" mode="aspectFit"></image>
      <text class="tips-text">等你的吃货队伍人员到齐 就可以按下 "出锅" 按钮 随机选中天选答案啦～</text>
    </view>
  </view>

  <!-- 操作按钮 - 放在页面底部 -->
  <view class="actions {{showActionsAnimation ? 'animate-in' : ''}}">
    <!-- 创建模式按钮 -->
    <button wx:if="{{mode === 'create'}}" class="common-btn create-btn" bindtap="createTask" loading="{{creating}}">
      {{creating ? '创建中...' : '炒起来'}}
    </button>
    
    <!-- 详情模式按钮 -->
    <block wx:else>
      <!-- 任务未结束时显示分享按钮：
           1. 创建者总是显示
           2. 非创建者：从分享页进入或已参与任务时显示 -->
      <button 
        class="icon-wrapper {{sharePressed ? 'pressed' : ''}}" 
        open-type="share" 
        wx:if="{{taskInfo.shareCode && taskInfo.status !== 'finished' && !taskInfo.selectedDish && (isCreator === true || fromShare || hasParticipated)}}"
        bindtouchstart="onShareTouchStart"
        bindtouchend="onShareTouchEnd"
      >
        <image class="icon-image" src="/images/icon_share.png" mode="aspectFit"></image>
      </button>
      <!-- 创建者显示图标：任务未结束时执行随机选择，任务已结束时查看结果 -->
      <view 
        class="icon-wrapper {{randoming ? 'randoming' : ''}} {{tapPressed ? 'pressed' : ''}}" 
        wx:if="{{isCreator === true && taskInfo.status !== 'finished' && !taskInfo.selectedDish}}" 
        bindtap="randomSelect"
        bindtouchstart="onRandomTouchStart"
        bindtouchend="onRandomTouchEnd"
      >
        <image class="icon-image" src="/images/icon_tap.png" mode="aspectFit"></image>
      </view>
    </block>
  </view>

  <!-- 随机选择结果遮罩和卡片 -->
  <view class="result-mask {{showResultMask ? 'show' : ''}}" wx:if="{{showResultMask}}" bindtap="closeResultMask">
    <view class="result-card-animated" catchtap="stopPropagation">
      <view class="result-card-header">
        <image class="result-card-title-icon" src="/images/icon_great.png" mode="aspectFit"></image>
      </view>
      <view class="result-card-content">
        <text class="result-card-dish">{{selectedDishResult}}</text>
      </view>
      <view class="result-card-footer">
        <text class="result-card-tip" catchtap="closeResultMask">点击任意处关闭</text>
      </view>
    </view>
  </view>
</view>

