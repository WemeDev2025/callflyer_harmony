/* pages/task/create/create.wxss */
.container {
  min-height: 100vh;
  background-color: #FFE6A8;
  padding: 40rpx;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
  padding-top: 40rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.form-section {
  width: 82%;
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 38rpx;
  padding: 66rpx;
  margin-bottom: 40rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.dishes-input {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.input {
  flex: 1;
  height: 80rpx;
  padding: 0 20rpx;
  background-color: #f5f5f5;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.title-input {
  width: 100%;
  height: 80rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.add-btn {
  width: 120rpx !important;
  min-width: 120rpx;
  max-width: 120rpx;
  height: 80rpx;
  background-color: #07c160;
  color: #fff;
  border-radius: 10rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  line-height: 1;
}

.add-btn::after {
  border: none;
}

.dishes-list {
  margin-top: 40rpx;
}

.dishes-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.dish-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.dish-tag {
  display: flex;
  align-items: center;
  background-color: #f0f0f0;
  border-radius: 30rpx;
  padding: 10rpx 20rpx;
  font-size: 26rpx;
}

.dish-name {
  color: #333;
  margin-right: 10rpx;
}

.dish-remove {
  color: #999;
  font-size: 32rpx;
  line-height: 1;
  cursor: pointer;
}

.actions {
  margin-top: 40rpx;
}

.create-btn {
  margin-bottom: 100rpx;
}

