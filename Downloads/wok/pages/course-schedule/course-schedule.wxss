.container {
  height: 100vh;
  background-color: #FFFFFF; /* 默认白色 */
  padding: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
}

.container.has-bg {
  background-color: transparent;
}

.bg-layer {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: -1;
  pointer-events: none;
  overflow: hidden;
}

.bg-image-real {
  width: 100%;
  height: 100%;
  display: block;
}

.bg-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  pointer-events: none;
}

/* Day Indicator Inside Swiper */
.day-title-overlay {
  padding: 0 40rpx;
  background-color: transparent;
  font-size: 44rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

/* Schedule List Styles */
.schedule-swiper {
  flex: 1;
  width: 100%;
  height: 0; 
  background-color: transparent;
}

.day-content {
  height: 100%;
  display: flex;
  flex-direction: column;
  background-color: transparent;
  overflow: hidden;
}

.day-scroll {
  flex: 1;
  height: 0;
  /* 增加底部内边距，避免底部按钮遮挡内容（兼容安全区） */
  /* 使用 safe-area 并增加基准值以保证更大间隙 */
  padding: 50rpx 40rpx calc(400rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background-color: transparent;
}

.bottom-spacer {
  /* 增加底部占位高度，确保滚动内容不会被底部操作栏遮挡 */
  height: calc(420rpx + env(safe-area-inset-bottom)); /* 更大基准 + 安全区预留 */
  width: 100%;
}

/* 隐藏原生滚动条 */
::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}

.course-card {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  margin-bottom: 40rpx;
  height: 160rpx;
  box-sizing: border-box;
}

/* 铃铛图标：右上角定位，确保可点击且可见 */
.reminder-bell {
  position: absolute !important;
  top: 12rpx !important;
  right: 20rpx !important;
  width: 64rpx !important;
  height: 64rpx !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  z-index: 200 !important;
  pointer-events: auto !important;
  transform: translateY(0) !important;
}

.bell-icon {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

/* 切换天时整体列表动画 */
.list-anim {
  width: 100%;
  height: 100%;
  will-change: transform, opacity;
}

@keyframes listInFromRight {
  0% {
    transform: translateX(60rpx);
  }
  100% {
    transform: translateX(0);
  }
}

@keyframes listInFromRight2 {
  0% {
    transform: translateX(60rpx);
  }
  100% {
    transform: translateX(0);
  }
}

@keyframes listInFromLeft {
  0% {
    transform: translateX(-60rpx);
  }
  100% {
    transform: translateX(0);
  }
}

@keyframes listInFromLeft2 {
  0% {
    transform: translateX(-60rpx);
  }
  100% {
    transform: translateX(0);
  }
}

@keyframes slideInFromRight {
  0% { 
    opacity: 0; 
    transform: translateX(60rpx); 
  }
  100% { 
    opacity: 1; 
    transform: translateX(0); 
  }
}

@keyframes slideInFromRight2 {
  0% { 
    opacity: 0; 
    transform: translateX(60rpx); 
  }
  100% { 
    opacity: 1; 
    transform: translateX(0); 
  }
}

@keyframes slideInFromLeft {
  0% { 
    opacity: 0; 
    transform: translateX(-60rpx); 
  }
  100% { 
    opacity: 1; 
    transform: translateX(0); 
  }
}

@keyframes slideInFromLeft2 {
  0% { 
    opacity: 0; 
    transform: translateX(-60rpx); 
  }
  100% { 
    opacity: 1; 
    transform: translateX(0); 
  }
}

.course-anim {
  display: flex;
  width: 100%;
  height: 100%;
}

.course-time {
  width: 120rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 10rpx;
}

.start-time {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.end-time {
  font-size: 22rpx;
  color: #999;
}

.time-line {
  width: 4rpx;
  height: 40rpx;
  background: #EEE;
  margin: 6rpx 0;
}

.course-info {
  flex: 0.85;
  min-width: 0;
  margin-left: 20rpx;
  padding: 30rpx;
  border-radius: 30rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative; /* for reminder-bell absolute positioning */
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.02);
  box-sizing: border-box;
}

recycle-item {
  display: block;
  width: 100%;
}

.course-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 10rpx;
}

.course-location {
  font-size: 24rpx;
  color: #666;
}

.empty-state {
  width: 100%;
  height: 800rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx; /* 往下移动 */
}

.empty-img-container {
  /* 容器负责：淡入 + 升起 (只执行一次) */
  animation: fadeInUp 1s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  display: flex;
  justify-content: center;
  width: 100%;
  margin-right: 55rpx;
}

.empty-img {
  width: 500rpx;
  height: 500rpx;
  margin-bottom: 40rpx;
  opacity: 0.9;
  /* 图片负责：无限循环左右轻微晃动 */
  animation: gentleSway 4s ease-in-out infinite;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes gentleSway {
  0%, 100% { transform: rotate(-3deg) translateX(-10rpx); }
  50% { transform: rotate(3deg) translateX(10rpx); }
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  text-align: center;
}

/* Bottom Bar Styles */
.bottom-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 40rpx 40rpx env(safe-area-inset-bottom);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  background: rgba(255, 255, 255, 0.85);
  z-index: 100;
  box-sizing: border-box;
}

.container.has-bg .bottom-bar {
  background: rgba(255, 255, 255, 0.35);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border-top: 1rpx solid rgba(255, 255, 255, 0.25);
}

.bottom-bar.samsung-offset {
  transform: translateY(40rpx);
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

.action-btn {
  flex: 1;
  width: 0; /* 强制等宽分配 */
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.2s ease;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  border: none;
}

.action-btn:active {
  transform: scale(0.95);
  opacity: 0.8;
}

button.action-btn::after {
  border: none;
}

.voice-btn-action {
  background: #FF6B35;
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 53, 0.2);
}

.add-btn-action {
  background: #5C7CFA;
  color: #FFFFFF;
}

.bg-btn-action {
  background: #FFD54F;
  color: #ffffff;
}

.share-btn-action {
  background: #28C76F;
  color: #FFFFFF;
  padding: 0;
  margin: 0;
  line-height: 96rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-icon {
  font-size: 32rpx;
}

.day-title-overlay {
  display: flex;
  align-items: center;
  gap: 16rpx;
  line-height: 1;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.home-entry-inline {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 0;
}

.day-title-text {
  font-size: 57rpx;
  font-weight: 700;
  margin-left: 0;
}

.home-icon-img {
  display: block;
}

.fallback-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fallback-icon-text {
  font-size: 36rpx;
  line-height: 1;
}

.voice-pulse {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 45rpx;
  animation: pulse 1s infinite alternate;
}

@keyframes pulse {
  0% { transform: scale(0.95); opacity: 0.4; }
  100% { transform: scale(1.05); opacity: 0.8; }
}

.choice-btn {
  width: 100% !important;
  height: 90rpx;
  background: #F0F3FF;
  color: #5C7CFA;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 40rpx;
}

.setting-item {
  margin-bottom: 30rpx;
}

.setting-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.reset-btn {
  width: 100% !important;
  height: 100rpx;
  background: #F5F6FA;
  color: #666;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

/* Modal Styles */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  animation: fadeIn 0.3s ease-out both;
}

.modal-mask.closing {
  animation: fadeOut 0.25s ease-in both;
}

.modal-content {
  width: 100%;
  background: #fff;
  border-top-left-radius: 50rpx;
  border-top-right-radius: 50rpx;
  padding: 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  animation: slideUp 0.3s cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

.modal-content.closing {
  animation: slideDown 0.25s cubic-bezier(0.8, 0.2, 0.8, 0.2) both;
}

.modal-mask.adjusting {
  background: transparent !important;
  transition: all 0.3s ease;
}

.modal-content.adjusting {
  opacity: 0 !important;
  transition: all 0.3s ease;
  pointer-events: auto;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes slideDown {
  from { transform: translateY(0); }
  to { transform: translateY(100%); }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes fadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

/* 语音识别蒙层样式 */
.voice-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: all 0.3s ease;
}

.voice-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.voice-card {
  width: 500rpx;
  background: rgba(255, 255, 255, 0.9);
  padding: 60rpx;
  border-radius: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
  transform: scale(0.8);
  transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.voice-overlay.show .voice-card {
  transform: scale(1);
}

.voice-waves {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 120rpx;
  margin-bottom: 40rpx;
}

.wave-bar {
  width: 12rpx;
  height: 40rpx;
  background: linear-gradient(to top, #FF6B35, #FFB627);
  border-radius: 6rpx;
  animation: wave 1s ease-in-out infinite;
}

.bar-1 { animation-delay: 0.1s; height: 60rpx; }
.bar-2 { animation-delay: 0.3s; height: 100rpx; }
.bar-3 { animation-delay: 0.2s; height: 80rpx; }
.bar-4 { animation-delay: 0.4s; height: 110rpx; }
.bar-5 { animation-delay: 0.1s; height: 70rpx; }

@keyframes wave {
  0%, 100% { transform: scaleY(0.4); opacity: 0.6; }
  50% { transform: scaleY(1); opacity: 1; }
}

.voice-status {
