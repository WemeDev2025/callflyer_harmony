}

.landscape-empty {
  text-align: center;
  color: #CCC;
  font-size: 14rpx;
  padding-top: 10rpx;
}


/* ── 语音功能首次引导提示 ─────────────────────────────────────────────────── */

.voice-tip-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  z-index: 3000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.3s ease both;
}

.voice-tip-card {
  width: 560rpx;
  background: #fff;
  border-radius: 48rpx;
  padding: 60rpx 50rpx 50rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.18);
  animation: tipCardIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

@keyframes tipCardIn {
  0%   { opacity: 0; transform: scale(0.78) translateY(40rpx); }
  100% { opacity: 1; transform: scale(1) translateY(0); }
}

.voice-tip-emoji {
  font-size: 88rpx;
  line-height: 1;
  margin-bottom: 28rpx;
}

.voice-tip-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 20rpx;
}

.voice-tip-desc {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  line-height: 1.7;
  margin-bottom: 48rpx;
  white-space: pre-line;
}

.voice-tip-btn {
  width: 100%;
  height: 96rpx;
  background: #FF6B35;
  color: #fff;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.3);
}

.voice-tip-btn:active {
  opacity: 0.85;
  transform: scale(0.97);
}
