/* ── Landscape Overview Mode ─────────────────────────────────────────────── */

.landscape-overview {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  z-index: 500;
  background: #fff;
  padding: 40rpx 60rpx;
  box-sizing: border-box;
}

.landscape-hint {
  text-align: center;
  font-size: 14rpx;
  color: #999;
  padding: 4rpx 0;
}

.landscape-grid {
  display: flex;
  flex-direction: row;
  flex: 1;
  height: 0;
}

.landscape-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  border-right: 1rpx solid #EEE;
}

.landscape-col-header {
  padding: 4rpx 0;
  text-align: center;
  font-size: 10rpx;
  font-weight: 600;
}

.landscape-col-scroll {
  flex: 1;
  height: 0;
}

.landscape-card {
  margin: 2rpx 2rpx;
  padding: 4rpx 5rpx;
  border-radius: 5rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4rpx;
}

.landscape-card-name {
  font-size: 14rpx;
  font-weight: 600;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.landscape-card-time {
