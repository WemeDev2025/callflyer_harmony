.container {
  height: 100vh;
  background-color: #FFFFFF; /* 默认白色 */
  padding: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
}

.container.has-bg {
  background-color: transparent;
}

.bg-layer {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: -1;
  pointer-events: none;
  overflow: hidden;
}

.bg-image-real {
  width: 100%;
  height: 100%;
  display: block;
}

/* Day Indicator Inside Swiper */
.day-title-overlay {
  padding: 30rpx 40rpx;
  background-color: transparent; /* 透明背景以显示底层图 */
  font-size: 36rpx;
  font-weight: 800;
  color: #1A1A1A;
  border-bottom: 1rpx solid rgba(0,0,0,0.05);
  flex-shrink: 0;
  animation: slideInRight 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

/* Schedule List Styles */
.schedule-swiper {
  flex: 1;
  width: 100%;
  height: 0; 
  background-color: transparent;
}

.day-content {
  height: 100%;
  display: flex;
  flex-direction: column;
  background-color: transparent;
  overflow: hidden;
}

.day-scroll {
  flex: 1;
  height: 0;
  padding: 20rpx 40rpx;
  box-sizing: border-box;
  background-color: transparent;
}

.bottom-spacer {
  height: 240rpx; /* 增加高度以留出底部按钮区的位置 */
  width: 100%;
}

/* 隐藏原生滚动条 */
::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}

.course-card {
  display: flex;
  margin-bottom: 40rpx;
  min-height: 160rpx;
  animation: slideInRight 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

@keyframes slideInRight {
  0% { 
    opacity: 0; 
    transform: translateX(60rpx); 
  }
  100% { 
    opacity: 1; 
    transform: translateX(0); 
  }
}

.course-time {
  width: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 10rpx;
}

.start-time {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.end-time {
  font-size: 22rpx;
  color: #999;
}

.time-line {
  width: 4rpx;
  height: 40rpx;
  background: #EEE;
  margin: 6rpx 0;
}

.course-info {
  flex: 1;
  padding: 30rpx;
  border-radius: 30rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.02);
}

.course-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 10rpx;
}

.course-location {
  font-size: 24rpx;
  color: #666;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  text-align: center;
}

/* Bottom Bar Styles */
.bottom-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
  z-index: 100;
  box-sizing: border-box;
}

.action-btn {
  flex: 1;
  width: 0; /* 强制等宽分配 */
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.2s ease;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.action-btn:active {
  transform: scale(0.95);
  opacity: 0.8;
}

.voice-btn-action {
  background: #FF6B35;
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 53, 0.2);
}

.bg-btn-action {
  background: #F0F3FF;
  color: #5C7CFA;
}

.add-btn-action {
  background: #1A1A1A;
  color: #FFFFFF;
}

.btn-icon {
  font-size: 32rpx;
}

.voice-pulse {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 45rpx;
  animation: pulse 1s infinite alternate;
}

@keyframes pulse {
  0% { transform: scale(0.95); opacity: 0.4; }
  100% { transform: scale(1.05); opacity: 0.8; }
}

.choice-btn {
  width: 100% !important;
  height: 90rpx;
  background: #F0F3FF;
  color: #5C7CFA;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 40rpx;
}

.setting-item {
  margin-bottom: 30rpx;
}

.setting-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.reset-btn {
  width: 100% !important;
  height: 100rpx;
  background: #F5F6FA;
  color: #666;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

/* Modal Styles */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  animation: fadeIn 0.3s ease-out both;
}

.modal-mask.closing {
  animation: fadeOut 0.25s ease-in both;
}

.modal-content {
  width: 100%;
  background: #fff;
  border-top-left-radius: 50rpx;
  border-top-right-radius: 50rpx;
  padding: 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  animation: slideUp 0.3s cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

.modal-content.closing {
  animation: slideDown 0.25s cubic-bezier(0.8, 0.2, 0.8, 0.2) both;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes slideDown {
  from { transform: translateY(0); }
  to { transform: translateY(100%); }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes fadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

/* 语音识别蒙层样式 */
.voice-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: all 0.3s ease;
}

.voice-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.voice-card {
  width: 500rpx;
  background: rgba(255, 255, 255, 0.9);
  padding: 60rpx;
  border-radius: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
  transform: scale(0.8);
  transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.voice-overlay.show .voice-card {
  transform: scale(1);
}

.voice-waves {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 120rpx;
  margin-bottom: 40rpx;
}

.wave-bar {
  width: 12rpx;
  height: 40rpx;
  background: linear-gradient(to top, #FF6B35, #FFB627);
  border-radius: 6rpx;
  animation: wave 1s ease-in-out infinite;
}

.bar-1 { animation-delay: 0.1s; height: 60rpx; }
.bar-2 { animation-delay: 0.3s; height: 100rpx; }
.bar-3 { animation-delay: 0.2s; height: 80rpx; }
.bar-4 { animation-delay: 0.4s; height: 110rpx; }
.bar-5 { animation-delay: 0.1s; height: 70rpx; }

@keyframes wave {
  0%, 100% { transform: scaleY(0.4); opacity: 0.6; }
  50% { transform: scaleY(1); opacity: 1; }
}

.voice-status {
  font-size: 36rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 16rpx;
}

.voice-tip {
  font-size: 24rpx;
  color: #999;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
  font-size: 36rpx;
  font-weight: bold;
}

.close-btn {
  font-size: 50rpx;
  color: #CCC;
  padding: 10rpx;
}

.input-field {
  width: 100%;
  height: 100rpx;
  background: #F5F6FA;
  border-radius: 24rpx;
  padding: 0 30rpx;
  margin-bottom: 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.time-pickers {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.time-pickers > picker {
  flex: 1;
}

.picker-item {
  background: #F5F6FA;
  padding: 24rpx;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
}

.label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.value {
  font-size: 32rpx;
  font-weight: 600;
}

.day-picker {
  margin-bottom: 40rpx;
}

.day-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.day-chip {
  padding: 12rpx 24rpx;
  background: #F5F6FA;
  border-radius: 40rpx;
  font-size: 24rpx;
  color: #666;
}

.day-chip.active {
  background: #5C7CFA;
  color: #FFF;
}

.modal-footer {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 20rpx;
}

.submit-btn {
  width: 100% !important;
  height: 100rpx;
  background: #1A1A1A;
  color: #FFF;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  z-index: 10;
}

.color-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 16rpx;
}

.color-chip {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  border: 4rpx solid #EEE;
  transition: all 0.2s ease;
}

.color-chip.active {
  transform: scale(1.2);
  border-color: #1A1A1A;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.1);
}

.box-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
  display: block;
}

.delete-btn {
  width: 100% !important;
  height: 100rpx;
  background: #FFF0F0;
  color: #FF4D4F;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  border: 1rpx solid #FFCCC7;
}

