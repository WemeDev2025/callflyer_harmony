<!--pages/index/index.wxml-->
<view class="container">
    <!-- ...existing code... -->
  <!-- 广告图遮罩 -->
  <view class="ad-image-mask {{adImageAnimating ? 'show' : ''}}" bindtap="closeAdImage" wx:if="{{showAdImage && adImagePath}}">
    <view class="ad-image-container {{adImageAnimating ? 'animating' : ''}}">
      <image 
        class="ad-image {{adClickType !== 'none' ? 'ad-image-clickable' : ''}}" 
        src="{{adImagePath}}" 
        mode="widthFix" 
        binderror="onAdImageError" 
        bindload="onAdImageLoad" 
        bindtap="onAdImageClick" 
        style="{{adImageWidth ? 'width: ' + adImageWidth + 'rpx;' : ''}}"
      ></image>
    </view>
  </view>

  <!-- 订阅消息引导弹窗 -->
  <view class="subscribe-guide-mask {{showSubscribeGuide ? 'show' : ''}}" bindtap="closeSubscribeGuide" wx:if="{{showSubscribeGuide}}">
    <view class="subscribe-guide-container" catchtap="stopPropagation">
      <view class="subscribe-guide-content">
        <view class="subscribe-guide-title">开启消息通知</view>
        <view class="subscribe-guide-desc">及时接收任务状态更新，不错过重要信息</view>
        <view class="subscribe-guide-buttons">
          <button class="subscribe-guide-btn cancel-btn" bindtap="closeSubscribeGuide">稍后再说</button>
          <button class="subscribe-guide-btn confirm-btn" bindtap="requestSubscribeAuth">立即开启</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 用户信息 - 顶部对齐胶囊 -->
  <view 
    class="user-info" 
    wx:if="{{userInfo}}" 
    hover-class="none"
    style="top: {{menuButtonTop}}px; height: {{menuButtonHeight}}px; right: {{menuButtonLeft}}px;"
  >
    <view class="user-info-left" hover-class="none" bindtap="goToProfile">
      <view class="user-avatar" hover-class="none">
        <image wx:if="{{userInfo.avatar_url}}" class="avatar-image" src="{{userInfo.avatar_url}}" mode="aspectFill"></image>
        <text wx:else class="avatar-text">饿</text>
      </view>
      <text class="user-nickname" hover-class="none">{{userInfo.nickname || '怎么称呼'}}</text>
      <image wx:if="{{userInfo.isVip}}" class="vip-icon" src="https://wemedev.com/wok/data/images/icon_vip.png" mode="aspectFit"></image>
    </view>
  </view>

  <!-- 上半部分：炒锅图片和动画 -->
  <view class="top-section">
    <view class="wok-card">
      <view class="wok-container">
        <image 
          class="wok-image {{animationClass}}" 
          src="https://wemedev.com/wok/data/images/pic_wok.png" 
          mode="aspectFit"
        ></image>
        <!-- 有结果文字时优先显示结果文字动画 -->
        <view class="text-particles" wx:if="{{resultTextChars && resultTextChars.length > 0}}">
          <text 
            class="text-particle" 
            wx:for="{{resultTextChars}}" 
            wx:key="index"
            wx:for-item="item"
            style="animation-delay: {{item.delay}}s; left: {{item.left}}; top: {{item.top}};"
          >{{item.char}}</text>
        </view>
        <!-- 参与者头像在铁锅中翻炒 -->
        <view class="avatars-in-wok" wx:elif="{{activeParticipants.length > 0}}">
          <image 
            class="avatar-particle" 
            wx:for="{{activeParticipants}}" 
            wx:key="index"
            wx:for-item="participant"
            style="{{participant.style}}"
            src="{{participant.avatar_url || participant.avatarUrl || ''}}" 
            mode="aspectFill"
          ></image>
        </view>
        <!-- 没有任务时显示默认文字动画 -->
        <view class="text-particles" wx:else>
          <text class="text-particle" style="animation-delay: 0s; left: 35%; top: 34.3%;">吃</text>
          <text class="text-particle" style="animation-delay: 0.3s; left: 50%; top: 39.3%;">点</text>
          <text class="text-particle" style="animation-delay: 0.6s; left: 45%; top: 49.3%;">啥</text>
        </view>
      </view>
      
      <!-- 随机选择图标 -->
      <!-- <view 
        class="random-icon-wrapper {{randoming ? 'randoming' : ''}} {{tapPressed ? 'pressed' : ''}}" 
        wx:if="{{activeTask && activeTask.isCreator && !activeTask.selectedDish}}" 
        bindtap="randomSelect"
        bindtouchstart="onRandomTouchStart"
        bindtouchend="onRandomTouchEnd"
      >
        <image class="icon-image" src="/images/icon_tap.png" mode="aspectFit"></image>
      </view> -->
    </view>
  </view>

  <!-- 轮播文案卡片 -->
  <view class="slogan-card">
    <view class="slogan-text {{sloganVisible ? 'fade-in' : 'fade-out'}}">
      {{sloganText}}
    </view>
  </view>

  <!-- 下半部分：操作按钮 -->
  <view class="bottom-section">
    <view class="actions">
      <button class="action-btn primary-btn" bindtap="createTask">投票</button>
      <button class="action-btn" bindtap="goToTasksList">更多</button>
      <button class="action-btn test-btn" bindtap="goToCourseSchedule">课程表</button>
    </view>
  </view>
</view>

