/* pages/index/index.wxss */
.container {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #FFE6A8;
}

/* 上半部分：炒锅图片和标题 */
.top-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  margin-top: 180rpx;
}



/* 随机选择图标样式 - 首页卡片右下角 */
.random-icon-wrapper {
  position: absolute;
  right: 80rpx;
  bottom: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 144rpx;
  height: 144rpx;
  transition: transform 0.1s ease;
  z-index: 10;
}

.random-icon-wrapper.pressed {
  transform: scale(0.9);
}

.random-icon-wrapper.pressed .icon-image {
  transform: scale(0.95);
}

.random-icon-wrapper.randoming {
  animation: randomPulse 1.5s ease-in-out infinite;
}

.icon-image {
  width: 144rpx !important;
  height: 144rpx !important;
  transition: transform 0.1s ease;
  display: block;
  flex-shrink: 0;
}

@keyframes randomPulse {
  0%, 100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.1);
    opacity: 0.8;
  }
}

.wok-container {
  width: 400rpx;
  height: 400rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
}

.wok-image {
  width: 400rpx;
  height: 400rpx;
  transition: transform 0.3s ease;
  transform-origin: center center;
}


/* 如果混合模式不行，尝试使用滤镜去除黑色 */
.fire-gif.show {
  opacity: 1;
  /* 使用 CSS 滤镜去除黑色背景（如果 GIF 本身有黑色背景） */
  filter: brightness(1.2) contrast(1.1);
}

/* 炒菜动画：模拟真实的旋绕运动轨迹 */
.wok-image.cooking {
  animation: wokCooking 2s cubic-bezier(0.42, 0, 0.58, 1) infinite;
  will-change: transform;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

/* 
 * 炒菜时锅的运动轨迹：
 * 1. 沿着椭圆形路径移动（圆周运动）- 模拟手腕的圆周运动
 * 2. 同时有轻微的旋转 - 模拟锅在运动中的自然旋转
 * 3. 运动轨迹流畅自然 - 增加更多关键帧确保连续性
 * 
 * 运动路径：顺时针椭圆形轨迹，使用更多关键帧实现平滑过渡
 */
@keyframes wokCooking {
  0% {
    transform: translate(0, 0) rotate(0deg) scale(1);
  }
  6.25% {
    transform: translate(10rpx, -15rpx) rotate(1.5deg) scale(1.008);
  }
  12.5% {
    transform: translate(15rpx, -20rpx) rotate(3deg) scale(1.015);
  }
  18.75% {
    transform: translate(18rpx, -15rpx) rotate(4deg) scale(1.018);
  }
  25% {
    transform: translate(20rpx, -10rpx) rotate(5deg) scale(1.02);
  }
  31.25% {
    transform: translate(18rpx, -5rpx) rotate(4deg) scale(1.018);
  }
  37.5% {
    transform: translate(15rpx, 2rpx) rotate(3deg) scale(1.015);
  }
  43.75% {
    transform: translate(10rpx, 5rpx) rotate(1.5deg) scale(1.008);
  }
  50% {
    transform: translate(0, 6rpx) rotate(0deg) scale(1);
  }
  56.25% {
    transform: translate(-10rpx, 5rpx) rotate(-1.5deg) scale(1.008);
  }
  62.5% {
    transform: translate(-15rpx, 2rpx) rotate(-3deg) scale(1.015);
  }
  68.75% {
    transform: translate(-18rpx, -2rpx) rotate(-4deg) scale(1.018);
  }
  75% {
    transform: translate(-20rpx, -10rpx) rotate(-5deg) scale(1.02);
  }
  81.25% {
    transform: translate(-18rpx, -15rpx) rotate(-4deg) scale(1.018);
  }
  87.5% {
    transform: translate(-15rpx, -20rpx) rotate(-3deg) scale(1.015);
  }
  93.75% {
    transform: translate(-10rpx, -15rpx) rotate(-1.5deg) scale(1.008);
  }
  100% {
    transform: translate(0, 0) rotate(0deg) scale(1);
  }
}

/* 参与者头像在铁锅中翻炒的动画 */
.avatars-in-wok {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 350rpx;
  height: 350rpx;
  margin-left: -175rpx;
  margin-top: -195rpx;
  pointer-events: none;
  overflow: hidden;
  border-radius: 50%;
}

.avatar-particle {
  position: absolute;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  background-color: #f0f0f0;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.3);
  animation: particleFloat 5s ease-in-out infinite;
  will-change: transform;
  transform-origin: center center;
  /* 动画时长和延迟通过内联样式动态设置 */
}

/* 随机粒子浮动动画 - 模拟在锅中大乱翻炒 */
@keyframes particleFloat {
  0% {
    transform: translate(0, 0) rotate(0deg) scale(1);
    opacity: 0.7;
  }
  10% {
    transform: translate(25rpx, -30rpx) rotate(36deg) scale(1.1);
    opacity: 1;
  }
  20% {
    transform: translate(-30rpx, 20rpx) rotate(72deg) scale(0.9);
    opacity: 0.9;
  }
  30% {
    transform: translate(30rpx, 25rpx) rotate(108deg) scale(1.05);
    opacity: 1;
  }
  40% {
    transform: translate(-20rpx, -25rpx) rotate(144deg) scale(0.95);
    opacity: 0.85;
  }
  50% {
    transform: translate(25rpx, -20rpx) rotate(180deg) scale(1.05);
    opacity: 1;
  }
  60% {
    transform: translate(-30rpx, 25rpx) rotate(216deg) scale(0.9);
    opacity: 0.9;
  }
  70% {
    transform: translate(20rpx, 30rpx) rotate(252deg) scale(1.1);
    opacity: 1;
  }
  80% {
    transform: translate(-25rpx, -30rpx) rotate(288deg) scale(0.95);
    opacity: 0.9;
  }
  90% {
    transform: translate(15rpx, -15rpx) rotate(324deg) scale(1.02);
    opacity: 1;
  }
  100% {
    transform: translate(0, 0) rotate(360deg) scale(1);
    opacity: 0.7;
  }
}

/* 文字粒子动画 - 没有任务时显示 */
.text-particles {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 350rpx;
  height: 350rpx;
  margin-left: -175rpx;
  margin-top: -203rpx;
  pointer-events: none;
  overflow: hidden;
  border-radius: 50%;
}

.text-particle {
  position: absolute;
  font-size: 48rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  animation: textFloat 5s ease-in-out infinite;
  will-change: transform;
  transform-origin: center center;
  /* 支持 emoji 显示 */
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Color Emoji", "Apple Color Emoji", "Segoe UI Emoji", sans-serif;
  line-height: 1.2;
}

/* 文字浮动动画 - 模拟在锅中大乱翻炒 */
@keyframes textFloat {
  0% {
    transform: translate(0, 0) rotate(0deg) scale(1);
    opacity: 0.8;
  }
  10% {
    transform: translate(30rpx, -35rpx) rotate(36deg) scale(1.15);
    opacity: 1;
  }
  20% {
    transform: translate(-35rpx, 25rpx) rotate(72deg) scale(0.9);
    opacity: 0.9;
  }
  30% {
    transform: translate(35rpx, 30rpx) rotate(108deg) scale(1.1);
    opacity: 1;
  }
  40% {
    transform: translate(-25rpx, -30rpx) rotate(144deg) scale(0.95);
    opacity: 0.85;
  }
  50% {
    transform: translate(30rpx, -25rpx) rotate(180deg) scale(1.1);
    opacity: 1;
  }
  60% {
    transform: translate(-35rpx, 30rpx) rotate(216deg) scale(0.9);
    opacity: 0.9;
  }
  70% {
    transform: translate(25rpx, 35rpx) rotate(252deg) scale(1.15);
    opacity: 1;
  }
  80% {
    transform: translate(-30rpx, -35rpx) rotate(288deg) scale(0.95);
    opacity: 0.9;
  }
  90% {
    transform: translate(20rpx, -20rpx) rotate(324deg) scale(1.05);
    opacity: 1;
  }
  100% {
    transform: translate(0, 0) rotate(360deg) scale(1);
    opacity: 0.8;
  }
}

.welcome {
  text-align: center;
}

.title {
  display: block;
  font-size: 80rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
}

.subtitle {
  display: block;
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 下半部分：用户信息和操作 */
.bottom-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding: 40rpx;
  margin-top: 80rpx;
}

.user-info {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  margin-left: 88rpx;
  gap: 20rpx;
}

.user-avatar {
  width: 114rpx;
  height: 114rpx;
  border-radius: 50%;
  cursor: pointer;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f0f0f0;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-text {
  font-size: 80rpx;
  font-weight: bold;
  color: #999;
  line-height: 1;
}

.user-nickname {
  font-size: 38rpx;
  color: #353535;
  white-space: nowrap;
  font-weight: 600;
}

/* 轮播文案卡片 */
.slogan-card {
  width: 90%;
  max-width: 600rpx;
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 38rpx;
  padding: 40rpx;
  margin: 0 auto 40rpx auto;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 120rpx;
  box-sizing: border-box;
  margin-top: 120rpx;
}

.slogan-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  text-align: center;
  transition: opacity 0.3s ease;
}

.slogan-text.fade-in {
  animation: fadeIn 0.6s ease-in-out;
}

.slogan-text.fade-out {
  opacity: 0;
}

@keyframes fadeIn {
  0% {
    opacity: 0;
    transform: translateY(10rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

.actions {
  width: 100%;
  max-width: 600rpx;
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-bottom: 66rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  background-color:#353535;
  color: #fff;
  border-radius: 66rpx;
  font-size: 32rpx;
}

.action-btn.primary-btn {
  background-color:#353535;
  font-weight: bold;
  font-size: 32rpx;
}

.action-btn::after {
  border: none;
}

