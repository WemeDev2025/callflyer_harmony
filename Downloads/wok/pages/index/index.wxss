/* pages/index/index.wxss */
.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

/* 上半部分：炒锅图片和标题 */
.top-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  padding-top: 80rpx;
}

.wok-container {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 40rpx;
  position: relative;
}

.wok-image {
  width: 400rpx;
  height: 400rpx;
  transition: transform 0.3s ease;
  transform-origin: center center;
}

/* 炒菜动画：模拟真实的旋绕运动轨迹 */
.wok-image.cooking {
  animation: wokCooking 3s cubic-bezier(0.42, 0, 0.58, 1) infinite;
  will-change: transform;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

/* 
 * 炒菜时锅的运动轨迹：
 * 1. 沿着椭圆形路径移动（圆周运动）- 模拟手腕的圆周运动
 * 2. 同时有轻微的旋转 - 模拟锅在运动中的自然旋转
 * 3. 运动轨迹流畅自然 - 增加更多关键帧确保连续性
 * 
 * 运动路径：顺时针椭圆形轨迹，使用更多关键帧实现平滑过渡
 */
@keyframes wokCooking {
  0% {
    transform: translate(0, 0) rotate(0deg) scale(1);
  }
  6.25% {
    transform: translate(10rpx, -15rpx) rotate(1.5deg) scale(1.008);
  }
  12.5% {
    transform: translate(15rpx, -20rpx) rotate(3deg) scale(1.015);
  }
  18.75% {
    transform: translate(18rpx, -15rpx) rotate(4deg) scale(1.018);
  }
  25% {
    transform: translate(20rpx, -10rpx) rotate(5deg) scale(1.02);
  }
  31.25% {
    transform: translate(18rpx, -5rpx) rotate(4deg) scale(1.018);
  }
  37.5% {
    transform: translate(15rpx, 5rpx) rotate(3deg) scale(1.015);
  }
  43.75% {
    transform: translate(10rpx, 12rpx) rotate(1.5deg) scale(1.008);
  }
  50% {
    transform: translate(0, 15rpx) rotate(0deg) scale(1);
  }
  56.25% {
    transform: translate(-10rpx, 12rpx) rotate(-1.5deg) scale(1.008);
  }
  62.5% {
    transform: translate(-15rpx, 5rpx) rotate(-3deg) scale(1.015);
  }
  68.75% {
    transform: translate(-18rpx, -5rpx) rotate(-4deg) scale(1.018);
  }
  75% {
    transform: translate(-20rpx, -10rpx) rotate(-5deg) scale(1.02);
  }
  81.25% {
    transform: translate(-18rpx, -15rpx) rotate(-4deg) scale(1.018);
  }
  87.5% {
    transform: translate(-15rpx, -20rpx) rotate(-3deg) scale(1.015);
  }
  93.75% {
    transform: translate(-10rpx, -15rpx) rotate(-1.5deg) scale(1.008);
  }
  100% {
    transform: translate(0, 0) rotate(0deg) scale(1);
  }
}

.welcome {
  text-align: center;
}

.title {
  display: block;
  font-size: 80rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
}

.subtitle {
  display: block;
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 下半部分：用户信息和操作 */
.bottom-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding: 40rpx;
  padding-bottom: 60rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  margin-bottom: 20rpx;
}

.user-nickname {
  font-size: 28rpx;
  color: #fff;
}

.actions {
  width: 100%;
  max-width: 600rpx;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  background-color: rgba(255, 255, 255, 0.2);
  color: #fff;
  border-radius: 10rpx;
  font-size: 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  margin-bottom: 30rpx;
}

.action-btn::after {
  border: none;
}

