/* pages/tasks/list/list.wxss */
.container {
  height: 100vh;
  background-color: #FFE6A8;
  padding: 0;
  display: flex;
  flex-direction: column;
  width: 100%;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 20rpx;
  padding: 20rpx 20rpx 0 20rpx;
  flex-shrink: 0;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.task-list {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  /* 隐藏滚动条 */
  scrollbar-width: none; /* Firefox */
  -ms-overflow-style: none; /* IE 10+ */
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0 0 0;
}

.task-list::-webkit-scrollbar {
  display: none; /* Chrome Safari */
}

.task-item {
  width: 95%;
  max-width: 700rpx;
  background-color: #ffffff;
  border-radius: 38rpx;
  padding: 12rpx 48rpx;
  margin: 0 auto 30rpx auto;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  box-sizing: border-box;
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.task-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.creator-info {
  display: flex;
  align-items: center;
  gap: 36rpx;
  flex: 1;
}

.creator-avatar {
  width: 114rpx;
  height: 114rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
}

.creator-details {
  display: flex;
  flex-direction: column;
  flex: 1;
  gap: rpx;
}

.creator-name {
  font-size: 38rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.task-time {
  font-size: 24rpx;
  color: #999;
}

.task-status-wrapper {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10rpx;
  margin-bottom: 44rpx;
}

.task-status {
  padding: 8rpx 20rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
}

.task-status.active {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  background-color: transparent;
}

.task-status.finished {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  background-color: transparent;
}

.task-status-icon {
  width: 166rpx;
  height: 166rpx;
}


.task-content {
  display: flex;
  justify-content: center;
  flex-direction: column;
  margin-bottom: 20rpx;
  gap: 12rpx;
}

.task-title-wrapper {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  margin-left: 10rpx;
}

.task-title-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.task-title {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.task-dishes {
  margin-bottom: 20rpx;
}

.dish-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 32rpx;
  margin-top: 22rpx;
}

.dish-tag {
  display: flex;
  align-items: flex-start;
  background-color: #f0f0f0;
  border-radius: 66rpx;
  padding: 18rpx 36rpx;
  font-size: 26rpx;
  max-width: 100%;
  box-sizing: border-box;
}

.dish-name {
  color: #333;
}

.dish-tag-selected {
  background-color: #1AA376 !important;
}

.dish-tag-selected .dish-name {
  color: #ffffff !important;
  font-weight: bold;
}

.task-stats {
  display: flex;
  align-items: center;
  gap: 30rpx;
  flex-wrap: wrap;
}

.participants-avatars {
  display: flex;
  align-items: center;
  gap: -10rpx;
  flex-wrap: wrap;
}

.participant-avatar-small {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #fff;
  background-color: #f0f0f0;
  margin-left: -10rpx;
}

.participant-avatar-small:first-child {
  margin-left: 0;
}

.participant-count {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
  border: 2rpx solid #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: -10rpx;
  font-size: 20rpx;
  color: #666;
}

.participant-count-placeholder {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
  border: 2rpx solid #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #666;
}

.stat-item {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
  display: inline-flex;
  align-items: center;
}

.stat-item.duration {
  color: #999;
  font-size: 24rpx;
  line-height: 1.5;
}



.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
  color: rgba(0, 0, 0, 1);
  font-size: 28rpx;
  margin-top: 400rpx;
}

.loading-more,
.no-more {
  text-align: center;
  padding: 40rpx;
  color: rgba(43, 43, 43, 0.8);
  font-size: 24rpx;
}

