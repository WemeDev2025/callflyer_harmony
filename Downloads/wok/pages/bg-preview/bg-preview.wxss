.preview-footer {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100vw;
  display: flex;
  justify-content: center;
  gap: 32rpx;
  padding-bottom: 48rpx;
  z-index: 100;
}
.preview-btn {
  min-width: 120rpx;
  height: 56rpx;
  font-size: 26rpx;
  border-radius: 28rpx;
  font-weight: 500;
  background: #3b82f6;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(59,130,246,0.08);
  transition: background 0.2s;
}
.preview-btn:last-child {
  background: #fff;
  color: #3b82f6;
  border: 1rpx solid #3b82f6;
}
.preview-btn:active {
  opacity: 0.8;
}
.preview-container {
  width: 100vw;
  height: 100vh;
  background: #000;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 9999;
}
.preview-header {
  position: absolute;
  left: 0;
  width: 100vw;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 100;
}
.preview-page {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  margin-right: 32rpx;
}
.preview-close {
  color: #fff;
  font-size: 40rpx;
  padding: 0 24rpx;
  cursor: pointer;
}
.preview-swiper {
  width: 100vw;
  height: 100vh;
}
.preview-img {
  width: 100vw;
  height: 100vh;
  object-fit: contain;
}