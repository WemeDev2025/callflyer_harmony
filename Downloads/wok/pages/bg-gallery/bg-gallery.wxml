<view>
  <view wx:if="{{loading}}" class="loading-mask">
    <view class="loading-spinner">
      <view class="refresher-dot-group">
        <view class="refresher-dot"></view>
        <view class="refresher-dot"></view>
        <view class="refresher-dot"></view>
      </view>
      <text class="loading-text">加载中...</text>
    </view>
  </view>
  <view wx:if="{{!loading}}" class="container">
  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="height: {{navBarHeight}}px;">
    <view class="nav-inner" style="margin-top: {{menuButtonTop}}px; height: {{menuButtonHeight}}px;">
      <view class="nav-back" bindtap="goBack">
        <image class="nav-back-icon" src="/images/icon_home.png" mode="aspectFit"></image>
      </view>
      <text class="nav-title">VIP 背景库</text>
    </view>
  </view>

  <!-- 图片网格 -->
  <scroll-view
    scroll-y
    class="gallery-scroll"
    style="top: {{navBarHeight}}px;"
    enhanced="{{false}}"
    show-scrollbar="{{false}}"
    enablePullDownRefresh="true"
    refresher-enabled="true"
    refresher-background="#fff"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onPullDownRefresh"
  >
    <view class="gallery-grid">
      <view
        class="gallery-card"
        wx:for="{{backgrounds}}"
        wx:key="__key"
        bindtap="onCardTap"
        data-index="{{index}}"
      >
        <image src="{{item.url}}" mode="aspectFill" class="gallery-img" lazy-load></image>
        <view wx:if="{{!isVip}}" class="lock-mask">
          <text class="lock-icon">🔒</text>
        </view>
        <view wx:if="{{isVip}}" class="use-btn" catchtap="onUseTap" data-index="{{index}}">
          <text class="use-btn-text">使用</text>
        </view>
      </view>
    </view>
    <view class="bottom-spacer"></view>
  </scroll-view>
  </view>
</view>
