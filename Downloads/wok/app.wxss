/**app.wxss**/
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
}

/* 共用按钮样式 - 参考 create 页 */
.common-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  background-color: #353535;
  color: #fff;
  border-radius: 66rpx;
  font-size: 32rpx;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  line-height: 1;
}

.common-btn::after {
  border: none;
}

