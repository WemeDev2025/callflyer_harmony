/* pages/preview/preview.wxss */
page {
  width: 100%;
  box-sizing: border-box;
}

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f9fa 0%, #e9ecef 100%);
  padding: 40rpx;
  padding-bottom: 160rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 移除加载状态样式 */

.card-container {
  background: white;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.15);
  overflow: hidden;
  margin-bottom: 40rpx;
  width: 100%;
  max-width: 100%;
}

/* 工作卡头部 */
.card-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx;
  display: flex;
  align-items: center;
  color: white;
}

.avatar-section {
  margin-right: 32rpx;
}

.avatar-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 24rpx;
  color: white;
}

.info-section {
  flex: 1;
}

.name {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.phone {
  font-size: 28rpx;
  opacity: 0.9;
  display: block;
  margin-bottom: 16rpx;
}

.badge {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  display: inline-block;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

/* 卡片内容区域 */
.card-section {
  padding: 32rpx 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.card-section:last-of-type {
  border-bottom: none;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

/* 证件列表 */
.cert-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.cert-item {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid #e9ecef;
}

.cert-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.cert-text {
  font-size: 24rpx;
  color: #666;
}

/* 技能标签 */
.skill-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.skill-tag {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 12rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  font-weight: 500;
}

/* 其他要求 */
.other-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  background: #f8f9fa;
  padding: 20rpx;
  border-radius: 12rpx;
  border-left: 4rpx solid #667eea;
}

.other-text.placeholder {
  color: #999;
  font-style: italic;
  background: #f0f0f0;
  border-left: 4rpx solid #ddd;
}

/* 工作卡底部 */
.card-footer {
  background: #f8f9fa;
  padding: 24rpx 40rpx;
  text-align: center;
}

.footer-text {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}

.create-time {
  font-size: 20rpx;
  color: #ccc;
  display: block;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 24rpx;
  position: fixed;
  bottom: 40rpx;
  left: 40rpx;
  right: 40rpx;
  width: calc(100% - 80rpx);
  box-sizing: border-box;
}

.action-btn {
  flex: 1;
  border-radius: 50rpx;
  padding: 24rpx 0;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
}

.edit-btn {
  background: #272727;
  color: white;
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.3);
}

.share-btn {
  background: #30C355;
  color: white;
  box-shadow: 0 8rpx 20rpx rgba(79, 172, 254, 0.3);
}

.action-btn:active {
  transform: translateY(2rpx);
}

