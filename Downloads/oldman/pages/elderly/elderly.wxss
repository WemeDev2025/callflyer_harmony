/* pages/elderly/elderly.wxss */

/* 页面级别样式 */
page {
  margin: 0;
  padding: 0;
  height: 100%;
  background: #3DC0B9;
}

.container {
  min-height: 100vh;
  height: 100vh;
  background: #3DC0B9;
  padding: 0;
  margin: 0;
  display: block;
  align-items: stretch;
  justify-content: flex-start;
  box-sizing: border-box;
}

/* Tab切换 */
.tab-container {
  display: flex;
  background: white;
  margin: 32rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.tab-item {
  flex: 1;
  padding: 24rpx 32rpx;
  text-align: center;
  background: #f3f3f3;
  transition: all 0.3s ease;
}

.tab-item.active {
  background: #ffffff;
  color: #3DC0B9;
}

.tab-text {
  font-size: 28rpx;
  font-weight: 500;
}

/* 筛选标签 */
.filter-tags {
  white-space: nowrap;
  margin-left: 36rpx;
  margin-bottom: 33rpx;
  padding: 0 0 10rpx 0;
  height: auto;
  min-height: 60rpx;
  display: block;
  overflow-x: auto;
  overflow-y: hidden;
}

.tag {
  display: inline-block;
  background: rgb(255, 255, 255);
  color: #666;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  margin-right: 20rpx;
  margin-left: 0;
  margin-top: 0;
  margin-bottom: 0;
  transition: all 0.2s ease;
  vertical-align: top;
  line-height: 1.2;
}

.tag.active {
  background: #161616 !important;
  color: white !important;
  font-weight: bold;
  font-size: 26rpx !important;
  padding: 12rpx 24rpx !important;
  margin-top: 0;
  margin-bottom: 0;
  vertical-align: top;
  line-height: 1.2;
  border-radius: 30rpx !important;
}

/* 内容列表 */
.content-list {
  padding: 0 32rpx;
}

.card-wrapper {
  margin-bottom: 32rpx;
}

.card-wrapper:active {
  transform: translateY(-2rpx);
}

/* 复用预览页面的卡片样式 */
.card-container {
  background: white;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.15);
  overflow: hidden;
  width: 100%;
  box-sizing: border-box;
}

/* 工作卡头部 */
.card-header {
  background:#FFFFFF;
  padding: 40rpx;
  display: flex;
  align-items: center;
  color: rgb(5, 5, 5);
  width: 100%;
  box-sizing: border-box;
}

.avatar-section {
  margin-right: 32rpx;
}

.avatar-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 24rpx;
  color: white;
}

.info-section {
  flex: 1;
}

.name {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.phone {
  font-size: 28rpx;
  opacity: 0.9;
  display: block;
  margin-bottom: 16rpx;
}

.badge {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  display: inline-block;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

/* 卡片内容区域 */
.card-section {
  padding: 32rpx 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
  width: 100%;
  box-sizing: border-box;
}

.card-section:last-of-type {
  border-bottom: none;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

/* 证件列表 */
.cert-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.cert-item {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid #e9ecef;
}

.cert-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.cert-text {
  font-size: 24rpx;
  color: #666;
}

/* 技能标签 */
.skill-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.skill-tag {
  background: #f8f9fa;
  color: #666;
  border-radius: 20rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  font-weight: 500;
}

/* 需求项目 */
.requirement-item {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #e9ecef;
}

.requirement-text {
  font-size: 26rpx;
  color: #666;
}

/* 其他要求 */
.other-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  background: #f8f9fa;
  padding: 20rpx;
  border-radius: 12rpx;
  border-left: 4rpx solid #667eea;
}

/* 工作卡底部 */
.card-footer {
  background: #f8f9fa;
  padding: 24rpx 40rpx;
  text-align: center;
  width: 100%;
  box-sizing: border-box;
}

.footer-text {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}

.create-time {
  font-size: 20rpx;
  color: #ccc;
  display: block;
}

/* 订单相关样式 */
.match-avatars {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-right: 32rpx;
}

.avatar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.avatar-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
}

.match-icon {
  font-size: 32rpx;
  margin: 0 10rpx;
}


.status-badge {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: bold;
  display: inline-block;
}

.status-badge.active {
  background: rgba(76, 175, 80, 0.2);
  color: #4caf50;
  border: 1rpx solid rgba(76, 175, 80, 0.3);
}

.status-badge.completed {
  background: rgba(158, 158, 158, 0.2);
  color: #9e9e9e;
  border: 1rpx solid rgba(158, 158, 158, 0.3);
}

/* 订单信息 */
.order-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-row {
  display: flex;
  align-items: center;
}

.info-label {
  font-size: 26rpx;
  color: #666;
  min-width: 140rpx;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

/* 联系方式 */
.contact-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.contact-item {
  display: flex;
  align-items: center;
}

.contact-label {
  font-size: 26rpx;
  color: #666;
  min-width: 100rpx;
}

.contact-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 32rpx;
  color: #999;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  display: block;
}
