<!--pages/elderly/elderly.wxml-->
<view class="container">
  <!-- Tab切换 -->
  <view class="tab-container">
    <view class="tab-item {{activeTab === 'nurses' ? 'active' : ''}}" 
          bindtap="onTabChange" data-tab="nurses">
      <text class="tab-text">护理员</text>
    </view>
    <view class="tab-item {{activeTab === 'employers' ? 'active' : ''}}" 
          bindtap="onTabChange" data-tab="employers">
      <text class="tab-text">雇主</text>
    </view>
    <view class="tab-item {{activeTab === 'orders' ? 'active' : ''}}" 
          bindtap="onTabChange" data-tab="orders">
      <text class="tab-text">已匹配</text>
    </view>
  </view>

  <!-- 筛选标签 -->
  <scroll-view scroll-x class="filter-tags">
    <view wx:for="{{filterOptions}}" wx:key="*this" 
          class="tag {{item === activeFilter ? 'active' : ''}}" 
          bindtap="onFilterTag" data-filter="{{item}}">
      {{item}}
    </view>
  </scroll-view>

  <!-- 护理员列表 -->
  <view class="content-list" wx:if="{{activeTab === 'nurses'}}">
    <!-- 空状态提示 -->
    <view wx:if="{{filteredNurses.length === 0 && dataLoaded}}" class="empty-state">
      <text class="empty-text">暂无已发布的护理员</text>
    </view>
    
    <!-- 护理员卡片列表 -->
    <view class="card-wrapper" wx:for="{{filteredNurses}}" wx:key="id" bindtap="onNurseTap" data-nurse="{{item}}">
      <!-- 复用预览页面的卡片结构 -->
      <view class="card-container">
        <!-- 工作卡头部 -->
        <view class="card-header">
          <view class="avatar-section">
            <image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" class="avatar-image" binderror="onImageError"></image>
            <view wx:else class="avatar-placeholder">
              <text class="avatar-text">{{item.name.charAt(0)}}</text>
            </view>
          </view>
          
          <view class="info-section">
            <text class="name">{{item.name}}</text>
            <text class="phone">{{item.phone}}</text>
          </view>
        </view>

        <!-- 证件信息 -->
        <view class="card-section">
          <text class="section-title">证件信息</text>
          <view class="cert-list">
            <view class="cert-item" wx:if="{{item.certs.idCard}}">
              <text class="cert-icon">🆔</text>
              <text class="cert-text">身份证</text>
            </view>
            <view class="cert-item" wx:if="{{item.certs.healthCard}}">
              <text class="cert-icon">🏥</text>
              <text class="cert-text">健康证</text>
            </view>
            <view class="cert-item" wx:if="{{item.certs.nursingCert}}">
              <text class="cert-icon">📜</text>
              <text class="cert-text">养老护理员资格证</text>
            </view>
            <view class="cert-item" wx:if="{{item.certs.firstAidCert}}">
              <text class="cert-icon">🚑</text>
              <text class="cert-text">急救员证书</text>
            </view>
          </view>
        </view>

        <!-- 专业技能 -->
        <view class="card-section">
          <text class="section-title">专业技能</text>
          <view class="skill-list">
            <view class="skill-tag" wx:for="{{item.skills}}" wx:key="*this" wx:for-item="skill">
              <text>{{skill}}</text>
            </view>
          </view>
        </view>

        <!-- 更多介绍 -->
        <view class="card-section">
          <text class="section-title">更多介绍</text>
          <text class="other-text">{{item.otherRequirements || '暂无更多介绍'}}</text>
        </view>

        

        <!-- 工作卡底部 -->
        <view class="card-footer">
          <text class="footer-text">瞻养乐园 - 专业养老服务平台</text>
          <text class="create-time">发布时间：{{item.createTime || '刚刚'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 雇主需求列表 -->
  <view class="content-list" wx:if="{{activeTab === 'employers'}}">
    <!-- 空状态提示 -->
    <view wx:if="{{filteredEmployers.length === 0 && dataLoaded}}" class="empty-state">
      <text class="empty-text">暂无已发布的雇主需求</text>
    </view>
    
    <view class="card-wrapper" wx:for="{{filteredEmployers}}" wx:key="id" bindtap="onEmployerTap" data-employer="{{item}}">
      <!-- 雇主需求卡片 -->
      <view class="card-container">
        <!-- 需求卡头部 -->
        <view class="card-header">
          <view class="avatar-section">
            <image wx:if="{{item.avatar && item.avatar !== '/static/avatar3.jpg'}}" src="{{item.avatar}}" class="avatar-image" binderror="onImageError"></image>
            <view wx:else class="avatar-placeholder">
              <text class="avatar-text">{{item.contactName.charAt(0)}}</text>
            </view>
          </view>
          
          <view class="info-section">
            <text class="name">{{item.contactName}}</text>
            <text class="phone">{{item.contactPhone}}</text>
            <view class="badge">养老需求</view>
          </view>
        </view>

        <!-- 性别要求 -->
        <view class="card-section">
          <text class="section-title">性别要求</text>
          <view class="gender-display">
            <text class="gender-text">{{item.gender === 'male' ? '男' : item.gender === 'female' ? '女' : '不限'}}</text>
          </view>
        </view>

        <!-- 证件要求 -->
        <view class="card-section">
          <text class="section-title">证件要求</text>
          <view class="cert-list">
            <view class="cert-item" wx:if="{{item.certs.idCard}}">
              <text class="cert-icon">🆔</text>
              <text class="cert-text">身份证</text>
            </view>
            <view class="cert-item" wx:if="{{item.certs.healthCard}}">
              <text class="cert-icon">🏥</text>
              <text class="cert-text">健康证</text>
            </view>
            <view class="cert-item" wx:if="{{item.certs.nursingCert}}">
              <text class="cert-icon">📜</text>
              <text class="cert-text">养老护理员资格证书</text>
            </view>
            <view class="cert-item" wx:if="{{item.certs.firstAidCert}}">
              <text class="cert-icon">🚑</text>
              <text class="cert-text">急救员证书</text>
            </view>
            <view wx:if="{{!item.certs.idCard && !item.certs.healthCard && !item.certs.nursingCert && !item.certs.firstAidCert}}" class="no-certs">
              <text class="no-certs-text">无特殊证件要求</text>
            </view>
          </view>
        </view>

        <!-- 所需服务 -->
        <view class="card-section">
          <text class="section-title">所需服务</text>
          <view class="skill-list">
            <view class="skill-tag" wx:for="{{item.services}}" wx:key="*this">
              <text>{{item}}</text>
            </view>
          </view>
        </view>

        <!-- 其他要求 -->
        <view class="card-section">
          <text class="section-title">其他要求</text>
          <text class="other-text">{{item.otherRequirements || '暂无特殊要求'}}</text>
        </view>

        <!-- 需求卡底部 -->
        <view class="card-footer">
          <text class="footer-text">瞻养乐园 - 专业养老服务平台</text>
          <text class="create-time">发布时间：{{item.createTime || '刚刚'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="content-list" wx:if="{{activeTab === 'orders'}}">
    <view class="card-wrapper" wx:for="{{filteredOrders}}" wx:key="id" bindtap="onOrderTap" data-order="{{item}}">
      <!-- 订单卡片 -->
      <view class="card-container">
        <!-- 订单头部 -->
        <view class="card-header">
          <view class="avatar-section">
            <view class="match-avatars">
              <view class="avatar-item">
                <image wx:if="{{item.employer.avatarUrl}}" src="{{item.employer.avatarUrl}}" class="avatar-image"></image>
                <view wx:else class="avatar-placeholder">
                  <text class="avatar-text">{{item.employer.name.charAt(0)}}</text>
                </view>
                <text class="avatar-label">雇主</text>
              </view>
              <view class="match-icon">💕</view>
              <view class="avatar-item">
                <image wx:if="{{item.nurse.avatarUrl}}" src="{{item.nurse.avatarUrl}}" class="avatar-image"></image>
                <view wx:else class="avatar-placeholder">
                  <text class="avatar-text">{{item.nurse.name.charAt(0)}}</text>
                </view>
                <text class="avatar-label">护理员</text>
              </view>
            </view>
          </view>
          
          <view class="info-section">
            <text class="name">订单 #{{item.orderNumber}}</text>
            <view class="status-badge {{item.status === '进行中' ? 'active' : 'completed'}}">
              {{item.status}}
            </view>
          </view>
        </view>

        <!-- 订单信息 -->
        <view class="card-section">
          <text class="section-title">护理信息</text>
          <view class="order-info">
            <view class="info-row">
              <text class="info-label">护理种类：</text>
              <text class="info-value">{{item.careType}}</text>
            </view>
            <view class="info-row">
              <text class="info-label">起始日期：</text>
              <text class="info-value">{{item.startDate}}</text>
            </view>
            <view class="info-row" wx:if="{{item.endDate}}">
              <text class="info-label">结束日期：</text>
              <text class="info-value">{{item.endDate}}</text>
            </view>
            <view class="info-row">
              <text class="info-label">服务时长：</text>
              <text class="info-value">{{item.duration}}</text>
            </view>
          </view>
        </view>

        <!-- 联系方式 -->
        <view class="card-section">
          <text class="section-title">联系方式</text>
          <view class="contact-info">
            <view class="contact-item">
              <text class="contact-label">雇主：</text>
              <text class="contact-value">{{item.employer.name}} {{item.employer.phone}}</text>
            </view>
            <view class="contact-item">
              <text class="contact-label">护理员：</text>
              <text class="contact-value">{{item.nurse.name}} {{item.nurse.phone}}</text>
            </view>
          </view>
        </view>

        <!-- 订单底部 -->
        <view class="card-footer">
          <text class="footer-text">瞻养乐园 - 专业养老服务平台</text>
          <text class="create-time">创建时间：{{item.createTime}}</text>
        </view>
      </view>
    </view>
  </view>


</view>
