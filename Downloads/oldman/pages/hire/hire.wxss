/* pages/hire/hire.wxss */
.container {
  min-height: 100vh;
  background: #f8f9fa;
  padding-bottom: 120rpx;
}

.header {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  padding: 60rpx 40rpx 40rpx;
  color: white;
  text-align: center;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  opacity: 0.9;
  display: block;
}

.form-container {
  padding: 40rpx;
}

.form-section {
  background: white;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  display: block;
}

/* 头像上传 */
.avatar-upload {
  display: flex;
  justify-content: center;
  margin: 24rpx 0;
}

.avatar-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid #e9ecef;
}

.avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #f8f9fa;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 24rpx;
  color: #6c757d;
}

/* 性别选择 */
.gender-section {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
}

.gender-item {
  flex: 1;
  background: #f8f9fa;
  border: 2rpx solid #e9ecef;
  border-radius: 16rpx;
  padding: 32rpx 16rpx;
  text-align: center;
  transition: all 0.3s ease;
}

.gender-selected {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: white;
  border-color: #f093fb;
  border-radius: 16rpx;
  font-weight: bold;
}

.gender-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 8rpx;
}

.gender-text {
  font-size: 26rpx;
  font-weight: bold;
}

/* 证件选择 */
.cert-section {
  margin-top: 16rpx;
}

.cert-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.cert-item:last-child {
  border-bottom: none;
}

.cert-label {
  font-size: 28rpx;
  color: #333;
}

/* 服务选择 */
.service-section {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.service-item {
  background: #f8f9fa;
  border: 2rpx solid #e9ecef;
  border-radius: 50rpx;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.service-selected {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: white;
  border-color: #f093fb;
  border-radius: 50rpx;
  font-weight: bold;
}

/* 输入框 */
.input {
  background: #f8f9fa;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  margin: 16rpx 0;
  width: 100%;
  box-sizing: border-box;
  min-height: 80rpx;
  line-height: 1.4;
  display: block;
}

.input:focus {
  border-color: #f093fb;
  background: white;
}

/* 文本域 */
.textarea {
  background: #f8f9fa;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
  margin-top: 16rpx;
}

.textarea:focus {
  border-color: #f093fb;
  background: white;
}

/* 发布按钮 */
.publish-btn-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 24rpx 40rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.publish-btn {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: white;
  border-radius: 50rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  width: 100%;
  box-shadow: 0 8rpx 20rpx rgba(240, 147, 251, 0.3);
}

.publish-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 10rpx rgba(240, 147, 251, 0.3);
}

