/* pages/index/index.wxss */
.container {
  min-height: 100vh;
  background: #3DC0B9;
  overflow-x: hidden;
  overflow-y: auto;
}

/* 用户状态栏样式 */
.user-status {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 20rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.user-info {
  flex: 1;
}

.welcome-text {
  color: white;
  font-size: 28rpx;
  font-weight: 500;
}

.user-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  background: rgba(255, 255, 255, 0.2);
  color: white;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 20rpx;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  line-height: 1;
}

.action-btn.logout {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.2);
}

.action-btn:active {
  background: rgba(255, 255, 255, 0.3);
}

/* 轮播图样式 */
.banner-swiper {
  width: 100%;
  height: 400rpx;
  margin-bottom: 40rpx;
}

.banner-item {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: white;
  position: relative;
}

.banner-title {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.banner-subtitle {
  font-size: 28rpx;
  opacity: 0.9;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.3);
}

.banner-tip {
  font-size: 20rpx;
  opacity: 0.8;
  margin-top: 8rpx;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.3);
  display: block;
}

/* 服务卡片容器 - 垂直布局 */
.services-container {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 0 32rpx;
  margin-bottom: 60rpx;
}

.service-card {
  background: white;
  border-radius: 22rpx;
  padding: 24rpx 18rpx;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
  width: 660rpx;
  max-width: 680rpx;
  height: 200rpx;
  margin: 0 auto;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}



.service-card:active {
  transform: translateY(-2rpx);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.2);
}

.service-text-container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 100%;
}

.service-title {
  font-size: 45rpx;
  font-weight: bold;
  color: #3C3C3C;
  margin-bottom: 8rpx;
  display: block;
}

.service-desc {
  font-size: 28rpx;
  color: #3C3C3C;
  opacity: 0.8;
  display: block;
}

/* 底部信息 */
.footer {
  padding: 40rpx;
  text-align: center;
  background: transparent;
  margin-top: auto;
}

.footer-text {
  font-size: 24rpx;
  color: #3C3C3C;
  opacity: 0.7;
}
