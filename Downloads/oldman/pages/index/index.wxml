<!--pages/index/index.wxml-->
<view class="container">

  <!-- 顶部轮播图 -->
  <swiper class="banner-swiper" indicator-dots="true" autoplay="true" interval="3000" duration="500">
    <swiper-item>
      <view class="banner-item" style="background-image: url('https://wemedev.com/static/banners/1570.png'); background-size: cover; background-position: center;" bindtap="onBannerTap">
        <text class="banner-title">瞻膳乐园</text>
        <text class="banner-subtitle">专业养老服务平台</text>
        <text class="banner-tip">点击查看详情</text>
      </view>
    </swiper-item>
    <swiper-item>
      <view class="banner-item" style="background-image: url('https://wemedev.com/static/banners/474251.jpg'); background-size: cover; background-position: center;" bindtap="onBannerTap">
        <text class="banner-title">贴心服务</text>
        <text class="banner-subtitle">让养老更安心</text>
      </view>
    </swiper-item>
    <swiper-item>
      <view class="banner-item" style="background-image: url('https://wemedev.com/static/banners/27261876.jpg'); background-size: cover; background-position: center;" bindtap="onBannerTap">
        <text class="banner-title">专业团队</text>
        <text class="banner-subtitle">用心呵护每一位老人</text>
      </view>
    </swiper-item>
  </swiper>

  <!-- 服务卡片区域 -->
  <view class="services-container">
    <view class="service-card" bindtap="onServiceTap" data-type="elderly">
      <view class="service-text-container">
        <text class="service-title">上门助老</text>
        <text class="service-desc">专业上门服务</text>
      </view>
    </view>

    <view class="service-card" bindtap="onServiceTap" data-type="work">
      <view class="service-text-container">
        <text class="service-title">我要找活</text>
        <text class="service-desc">发布求职信息</text>
      </view>
    </view>

    <view class="service-card" bindtap="onServiceTap" data-type="hire">
      <view class="service-text-container">
        <text class="service-title">养老请人</text>
        <text class="service-desc">寻找专业护理</text>
      </view>
    </view>

    <view class="service-card" bindtap="onServiceTap" data-type="business">
      <view class="service-text-container">
        <text class="service-title">惠享商服</text>
        <text class="service-desc">优质商品服务</text>
      </view>
    </view>

    <view class="service-card" bindtap="onServiceTap" data-type="account">
      <view class="service-text-container">
        <text class="service-title">我的账号</text>
        <text class="service-desc">个人中心</text>
      </view>
    </view>
  </view>

</view>
