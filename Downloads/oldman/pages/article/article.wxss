/* pages/article/article.wxss */
.container {
  min-height: 100vh;
  background: #f8f9fa;
  padding-bottom: 40rpx;
}

/* 文章头部 */
.article-header {
  background: white;
  padding: 40rpx 32rpx;
  border-bottom: 1rpx solid #e9ecef;
}

.article-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  margin-bottom: 20rpx;
  display: block;
}

.article-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.publish-time {
  font-size: 24rpx;
  color: #666;
}

.read-count {
  font-size: 24rpx;
  color: #999;
}

/* 文章内容 */
.article-content {
  background: white;
  padding: 32rpx;
  margin-top: 20rpx;
}

.content-section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  display: block;
  border-left: 6rpx solid #F9C1B1;
  padding-left: 20rpx;
}

.content-paragraph {
  margin-bottom: 24rpx;
}

.paragraph-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  display: block;
  text-indent: 2em;
}


/* 文章底部 */
.article-footer {
  background: linear-gradient(135deg, #F9C1B1 0%, #f8d7da 100%);
  padding: 40rpx 32rpx;
  text-align: center;
  margin-top: 20rpx;
  border-radius: 16rpx;
}

.footer-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

.footer-subtitle {
  font-size: 24rpx;
  color: #666;
  display: block;
}
