<!--pages/work-card/work-card.wxml-->
<view class="container">


  <view class="form-container">
    <!-- 头像上传 -->
    <view class="form-section">
      <text class="section-title">头像</text>
      <view class="avatar-upload" bindtap="chooseAvatar">
        <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" class="avatar-image"></image>
        <view wx:else class="avatar-placeholder">
          <text class="avatar-text">上传头像</text>
        </view>
      </view>
    </view>

    <!-- 基本信息 -->
    <view class="form-section">
      <text class="section-title">基本信息</text>
      <input class="input" placeholder="姓名" value="{{name}}" bindinput="onNameInput" />
      <input class="input" placeholder="电话" value="{{phone}}" bindinput="onPhoneInput" />
    </view>

    <!-- 证件上传 -->
    <view class="form-section">
      <text class="section-title">验证资质</text>
      <view class="cert-section">
        <view class="cert-item">
          <text class="cert-label">身份证</text>
          <view class="cert-content">
            <view class="cert-upload-area" bindtap="uploadCert" data-type="idCard">
              <image wx:if="{{certs.idCard}}" src="{{certs.idCard}}" class="cert-image"></image>
              <view wx:else class="cert-placeholder">
                <text class="placeholder-text">点击上传身份证</text>
              </view>
              <view wx:if="{{certs.idCard}}" class="update-overlay">
                <button class="update-btn">更新</button>
              </view>
            </view>
          </view>
        </view>
        <view class="cert-item">
          <text class="cert-label">健康证</text>
          <view class="cert-content">
            <view class="cert-upload-area" bindtap="uploadCert" data-type="healthCard">
              <image wx:if="{{certs.healthCard}}" src="{{certs.healthCard}}" class="cert-image"></image>
              <view wx:else class="cert-placeholder">
                <text class="placeholder-text">点击上传健康证</text>
              </view>
              <view wx:if="{{certs.healthCard}}" class="update-overlay">
                <button class="update-btn">更新</button>
              </view>
            </view>
          </view>
        </view>
        <view class="cert-item">
          <text class="cert-label">养老护理员资格证书</text>
          <view class="cert-content">
            <view class="cert-upload-area" bindtap="uploadCert" data-type="nursingCert">
              <image wx:if="{{certs.nursingCert}}" src="{{certs.nursingCert}}" class="cert-image"></image>
              <view wx:else class="cert-placeholder">
                <text class="placeholder-text">点击上传资格证书</text>
              </view>
              <view wx:if="{{certs.nursingCert}}" class="update-overlay">
                <button class="update-btn">更新</button>
              </view>
            </view>
          </view>
        </view>
        <view class="cert-item">
          <text class="cert-label">急救员证书</text>
          <view class="cert-content">
            <view class="cert-upload-area" bindtap="uploadCert" data-type="firstAidCert">
              <image wx:if="{{certs.firstAidCert}}" src="{{certs.firstAidCert}}" class="cert-image"></image>
              <view wx:else class="cert-placeholder">
                <text class="placeholder-text">点击上传急救员证书</text>
              </view>
              <view wx:if="{{certs.firstAidCert}}" class="update-overlay">
                <button class="update-btn">更新</button>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 擅长内容 -->
    <view class="form-section">
      <text class="section-title">擅长内容</text>
      <view class="skill-section">
        <view class="skill-item {{item.selected ? 'skill-selected' : ''}}" 
              wx:for="{{skills}}" 
              wx:key="name"
              bindtap="onSkillTap" 
              data-index="{{index}}">
          <text>{{item.name}}</text>
        </view>
      </view>
    </view>

    <!-- 其他要求 -->
    <view class="form-section">
      <text class="section-title">自我介绍</text>
      <textarea class="textarea" 
                placeholder="请输入更多职业优势..." 
                value="{{otherRequirements}}" 
                bindinput="onOtherInput"
                maxlength="200"></textarea>
    </view>
  </view>

  <!-- 预览按钮 -->
  <view class="preview-btn-container">
    <button class="preview-btn" bindtap="previewCard">预览工作卡</button>
  </view>
</view>