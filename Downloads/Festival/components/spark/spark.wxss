.sparkles { 
  position: absolute; 
  left: 0; 
  width: 100%; 
  height: 100%; 
  pointer-events: none;
  z-index: 1; /* 在背景之上 */
}
.spark { 
  width: 8rpx; 
  height: 8rpx; 
  background: rgba(255,255,255,0.95); 
  border-radius: 50%; 
  position: absolute; 
  transform: translate(-50%, -50%); 
  animation-name: floatUp; 
  animation-timing-function: ease-out; /* 改为缓出，让动画更自然 */
  animation-iteration-count: 2; /* 播放2次，总共14秒后消失 */
  animation-fill-mode: forwards; /* 保持动画结束状态 */
  box-shadow: 0 0 6rpx rgba(255, 255, 255, 0.8); /* 添加光晕效果 */
}

@keyframes floatUp {
  0% { 
    transform: translate(-50%, 0) scale(0.5); 
    opacity: 0.3; 
  }
  20% {
    opacity: 1; /* 进入卡片时变亮 */
  }
  80% {
    opacity: 0.8; /* 离开卡片时保持亮度 */
  }
  100% { 
    transform: translate(-50%, -600rpx) scale(1.4); /* 飞得更高 */
    opacity: 0; 
  }
}
