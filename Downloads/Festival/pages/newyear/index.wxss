/* ========== 页面基础样式 ========== */
.page {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  padding: 0;
  box-sizing: border-box;
  background: #000000;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}


/* ========== 自定义导航栏 ========== */
.custom-navbar {
  position: relative;
  width: 100%;
  z-index: 1000;
  background: transparent;
}

.navbar-content {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  position: relative;
}

.navbar-back {
  position: absolute;
  left: 20rpx;
  font-size: 48rpx;
  color: #ffffff;
  font-weight: 300;
  line-height: 1;
}

.navbar-title {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: 500;
}

/* ========== 卡片容器 ========== */
.card-container {
  width: 100%;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  overflow: hidden;
}

/* ========== Group 395 ========== */
.group-395 {
  position: relative;
  width: 764rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: rpx;
}

/* ========== Vector 容器 ========== */
.vector-wrapper {
  position: relative;
  width: 100%;
  height: 1074rpx;
}

/* ========== 光芒效果 ========== */
.vector-glow {
  position: absolute;
  top: 0rpx;
  left: 0rpx;
  right: 0rpx;
  bottom: 0rpx;
  border-radius: 66rpx;
  background: radial-gradient(
    circle,
    rgba(253, 250, 215, 0.9) 0%,
    rgba(255, 215, 0, 0.7) 30%,
    rgba(228, 21, 37, 0.6) 60%,
    rgba(253, 250, 215, 0.3) 100%
  );
  animation: glowScale 2s ease-in-out infinite;
  z-index: 1;
  filter: blur(66rpx);
  box-shadow: 
    0 0 60rpx rgba(253, 250, 215, 0.6),
    0 0 100rpx rgba(255, 215, 0, 0.4),
    0 0 140rpx rgba(228, 21, 37, 0.3);
}

@keyframes glowScale {
  0% {
    transform: scaleX(1) scaleY(1);
    opacity: 0.8;
  }
  50% {
    transform: scaleX(1.15) scaleY(1.05);
    opacity: 1;
  }
  100% {
    transform: scaleX(1) scaleY(1);
    opacity: 0.8;
  }
}

/* ========== Vector ========== */
.vector {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  height: 1074rpx;
  background: #E41525;
  border-radius: 44rpx;
  overflow: hidden;
  z-index: 1;
}

.vector-bg-wrapper {
  position: relative;
  width: 100%;
  height: 40%;
  margin-bottom: 50rpx;
}

/* ========== Vector 背景图片 ========== */
.vector-bg {
  width: 100%;
  height: 100%;
  flex: none;
  margin-top: 44rpx;
}

/* ========== 爆炸粒子 ========== */
.explosion-particle-outer {
  position: fixed;
  z-index: 10000;
  pointer-events: none;
  animation: particleFallY 2s ease-out forwards;
}

.explosion-particle-inner {
  animation: particleFallTransform 2s ease-out forwards;
}

.particle-img {
  width: 77rpx;
  height: 77rpx;
}

@keyframes particleFallY {
  0% {
    transform: translateY(0);
  }
  100% {
    transform: translateY(100vh);
  }
}

@keyframes particleFallTransform {
  0% {
    opacity: 1;
  }
  30% {
    opacity: 0.9;
  }
  100% {
    opacity: 0;
  }
}

/* ========== 提词器内容 ========== */
.teleprompter-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.85), rgba(0, 0, 0, 0.95));
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 40rpx 40rpx 40rpx;
  box-sizing: border-box;
  z-index: 2;
}

.teleprompter {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  padding: 0 20rpx;
}

.teleprompter-title {
  font-size: 36rpx;
  color: #FBC34C;
  letter-spacing: 4rpx;
  text-align: center;
}

.teleprompter-text {
  font-size: 48rpx;
  color: #ffffff;
  line-height: 1.6;
  letter-spacing: 2rpx;
  word-break: break-all;
  text-align: center;
  /* 默认使用 Douyin Sans 字体，可通过服务器配置覆盖 */
  font-family: 'Douyin Sans', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.teleprompter-refresh-btn {
  position: absolute;
  bottom: 30rpx;
  right: 30rpx;
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  color: #5C1A0F;
  background: linear-gradient(180deg, #FFD05A 0%, #FBBE3C 100%);
  border: none;
  border-radius: 999rpx;
  line-height: 1;
  min-width: 140rpx;
  text-align: center;
}

/* ========== 头像和昵称 ========== */
.info-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 66rpx;
  width: 100%;
}

.avatar {
  transition: transform 0.3s ease;
  width: 144rpx;
  height: 144rpx;
  border: 6rpx solid #FDFAD7;
  background: #4a4a5a;
  border-radius: 50%;
  flex-shrink: 0;
  margin: 0;
  padding: 0;
}

.nickname-container {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  flex-shrink: 0;
}

.nickname {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  font-weight: 700;
  font-size: 66rpx;
  line-height: 170%;
  color: #FDFAD7;
  margin: 0;
  padding: 0;
}

.nickname-label {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  font-weight: 400;
  font-size: 36rpx;
  line-height: 170%;
  color: #FDFAD7;
  margin: 0;
  padding: 0;
}

/* 播放音频时头像逆时针旋转（模拟胶片） */
.avatar-rotating {
  animation: avatarRotateCounterClockwise 3s linear infinite;
}

@keyframes avatarRotateCounterClockwise {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(-360deg);
  }
}

.avatar-animate {
  animation: slideInFromLeft 0.8s ease-out forwards;
}

.nickname-animate {
  animation: slideInFromRight 0.8s ease-out forwards;
}

@keyframes slideInFromLeft {
  0% {
    opacity: 0;
    transform: translateX(-80rpx);
  }
  100% {
    transform: translateX(0);
  }
}

@keyframes slideInFromRight {
  0% {
    opacity: 0;
    transform: translateX(80rpx);
  }
  100% {
    transform: translateX(0);
  }
}

.nickname-label2{
  font-size: 44rpx;
  font-weight: 500;
  margin-top: 66rpx;
  font-style: oblique;
  color:#FDFAD7;
}

/* ========== 收听祝福按钮 ========== */
.blessing-btn {
  transition: transform 0.1s ease, opacity 0.1s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 66rpx;
  padding: 20rpx 160rpx;
  background: #FDFAD7;
  border-radius: 66rpx;
  border: none;
  font-size: 38rpx;
  font-weight: 600;
  color: #E41525;
  line-height: 1;
}

.blessing-btn::after {
  border: none;
}

.blessing-btn:active {
  transform: scale(0.95);
  opacity: 0.9;
}

/* ========== 重录按钮 ========== */
.re-record-btn {
  margin-top: 20rpx;
  padding: 16rpx 120rpx;
  background: transparent;
  border: none;
  border-radius: 66rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #FDFAD7;
  line-height: 1;
}

.re-record-btn::after {
  border: none;
}

/* ========== 提词器按钮 ========== */
.teleprompter-btn {
  margin-top: 20rpx;
  padding: 16rpx 120rpx;
  background: transparent;
  border: none;
  border-radius: 66rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #FDFAD7;
  line-height: 1;
}

.teleprompter-btn::after {
  border: none;
}

/* ========== 淡入动画 ========== */
.fade-in {
  animation: fadeIn 0.4s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ========== 底部按钮容器 ========== */
.bottom-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  z-index: 100;
}

/* ========== 统计信息文字 ========== */
.stats-text {
  font-size: 28rpx;
  color: #FDFAD7;
  text-align: center;
  margin-bottom: 10rpx;
}

/* ========== 按钮组 ========== */
.bottom-buttons-group {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

/* ========== 底部按钮通用样式 ========== */
.bottom-btn {
  padding: 28rpx 120rpx;
  background: transparent;
  border: 2rpx solid #FDFAD7;
  border-radius: 66rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #FDFAD7;
  line-height: 1;
}

.bottom-btn::after {
  border: none;
}

/* ========== 解锁码激活卡片样式 ========== */
.input-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  background: rgba(0, 0, 0, 0);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: background 0.3s ease, opacity 0.3s ease;
  pointer-events: none;
}

.input-mask.show {
  background: rgba(0, 0, 0, 0.75);
  opacity: 1;
  pointer-events: auto;
}

.input-card {
  width: 600rpx;
  background: #2a2a3a;
  border-radius: 24rpx;
  overflow: hidden;
  transform: scale(0.8) translateY(50rpx);
  opacity: 0;
  transition: transform 0.3s ease, opacity 0.3s ease;
}

.input-card.show {
  transform: scale(1) translateY(0);
  opacity: 1;
}

.input-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #3a3a4a;
}

.input-card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.input-card-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  line-height: 1;
  color: #999999;
  cursor: pointer;
}

.input-card-body {
  padding: 32rpx;
}

.unlock-code-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 32rpx;
  padding: 24rpx 0;
}

.hint-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #ffffff;
  text-align: center;
}

.hint-text-small {
  font-size: 24rpx;
  color: #999999;
  text-align: center;
}

.unlock-code-features {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.purchase-section {
  margin-bottom: 24rpx;
}

.purchase-hint {
  margin-bottom: 16rpx;
  text-align: center;
}

.purchase-hint-text {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.5;
}

.purchase-btn {
  width: 100%;
  padding: 20rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  border-radius: 12rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(255, 215, 0, 0.3);
}

.purchase-btn::after {
  border: none;
}

.purchase-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #000000;
}

.divider-line {
  display: flex;
  align-items: center;
  margin: 24rpx 0;
  position: relative;
}

.divider-line::before,
.divider-line::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: #3a3a4a;
}

.divider-text {
  padding: 0 16rpx;
  font-size: 24rpx;
  color: #666666;
}

.input-card-input {
  width: 100%;
  height: 88rpx;
  padding: 0 20rpx;
  border: 1rpx solid #3a3a4a;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 88rpx;
  color: #e0e0e0;
  background: #1a1a2a;
  box-sizing: border-box;
}

.input-card-footer {
  padding: 24rpx 32rpx 32rpx;
  display: flex;
  justify-content: flex-end;
}

.input-card-btn {
  padding: 16rpx 48rpx;
  background: #FBC34C;
  border-radius: 12rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 600;
  color: #000000;
  line-height: 1;
}

.input-card-btn::after {
  border: none;
}

.input-card-btn[disabled] {
  opacity: 0.6;
}

/* ========== 微信支付提示卡片样式 ========== */
.wxpay-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 32rpx;
  padding: 24rpx 0;
}

.hint-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FBC34C;
  text-align: center;
}

.hint-desc {
  font-size: 28rpx;
  font-weight: 500;
  color: #ffffff;
  text-align: center;
}

.wxpay-features {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background: rgba(251, 195, 76, 0.1);
  border-radius: 12rpx;
  border: 1rpx solid rgba(251, 195, 76, 0.2);
}

.feature-icon {
  font-size: 32rpx;
  line-height: 1;
}

.feature-text {
  font-size: 26rpx;
  color: #e0e0e0;
  flex: 1;
}

.wxpay-confirm-btn {
  width: 100%;
  background: linear-gradient(135deg, #FBC34C 0%, #FFD700 100%);
  font-size: 30rpx;
  font-weight: 600;
  padding: 20rpx 48rpx;
}

