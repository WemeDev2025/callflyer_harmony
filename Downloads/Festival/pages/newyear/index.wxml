<view class="page">
  <!-- 爆炸掉落粒子 -->
  <block wx:for="{{explosionParticles}}" wx:key="id" wx:for-item="particle">
    <view class="explosion-particle-outer" style="left:{{particle.leftPercent}};top:{{particle.topPercent}};animation-delay:{{particle.delay}}s">
      <view class="explosion-particle-inner" style="transform:{{particle.initialTransform}}">
        <image class="particle-img" src="/images/icon_bang.png" mode="aspectFit"></image>
      </view>
    </view>
  </block>
  
  <!-- 拜年卡片容器 -->
  <view class="card-container">
    <!-- Group 395 -->
    <view class="group-395">
      <!-- Vector -->
      <view class="vector-wrapper">
        <view class="vector-glow"></view>
        <view class="vector">
          <view class="vector-bg-wrapper">
            <image class="vector-bg" src="https://wemedev.com/data/festival/images/bg_horse.png" mode="aspectFit"></image>
            <view class="teleprompter-overlay" wx:if="{{showTeleprompter}}">
              <view class="teleprompter">
              <text class="teleprompter-title">拜年提词器</text>
              <text class="teleprompter-text {{teleprompterAnimating ? 'fade-in' : ''}}" style="font-family: {{teleprompterFontFamily || 'Douyin Sans, PingFang SC, Microsoft YaHei, sans-serif'}};">{{teleprompterText}}</text>
              </view>
            <button class="teleprompter-refresh-btn" bindtap="onRefreshTeleprompter">换一句</button>
            </view>
          </view>
        <!-- 头像和昵称 -->
        <view class="info-header">
          <image class="avatar {{isSharedPage ? 'avatar-animate' : ''}} {{isPlaying ? 'avatar-rotating' : ''}}" src="{{avatarUrl || '/images/icon_avatar.png'}}" mode="aspectFill"></image>
          <view class="nickname-container {{isSharedPage ? 'nickname-animate' : ''}}">
            <text class="nickname">{{nickname || '昵称'}}</text> 
            <text class="nickname-label">给您拜年啦～</text>  
          </view>
        </view>
        <text class="nickname-label2">想说的话都在这了</text>  
        <!-- 录音/试听按钮 -->
        <button class="blessing-btn" bindtap="onListenBlessing">{{buttonText}}</button>
        <!-- 打开提词器 -->
        <button class="teleprompter-btn" bindtap="onOpenTeleprompter" wx:if="{{!hasRecorded || isRecording}}">
          {{teleprompterLoading ? '加载中...' : (showTeleprompter ? '关闭提词器' : '打开提词器')}}
        </button>
        <!-- 重录按钮 -->
        <button class="re-record-btn" bindtap="onReRecord" wx:if="{{hasRecorded && !isSharedPage}}">重录</button>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 底部按钮容器 -->
  <view class="bottom-buttons">
    <!-- 统计信息（只在非分享页面且不显示分享祝福按钮时显示） -->
    <view class="stats-text" wx:if="{{uploaderCount > 0 && !isSharedPage && !(hasRecorded && shareId && !isSharedPage)}}">哇 有 {{uploaderCount}} 人完成了拜年任务</view>
    
    <!-- 按钮组 -->
    <view class="bottom-buttons-group">
      <!-- 分享按钮（只在非分享页面显示） -->
      <button class="bottom-btn" open-type="share" wx:if="{{hasRecorded && shareId && !isSharedPage}}">分享祝福</button>
      <!-- 接力拜年按钮（分享状态） -->
      <button class="bottom-btn" bindtap="goToHome" wx:if="{{isSharedPage}}">接力拜年</button>
    </view>
  </view>

  <!-- 微信支付提示卡片遮罩和卡片 -->
  <view class="input-mask {{showWxPayCard ? 'show' : ''}}" bindtap="closeWxPayCard" wx:if="{{showWxPayCard}}">
    <view class="input-card {{wxPayCardShow ? 'show' : ''}}" catchtap="stopPropagation">
      <view class="input-card-header">
        <text class="input-card-title">解锁提词器</text>
        <text class="input-card-close" bindtap="closeWxPayCard">×</text>
      </view>
      <view class="input-card-body">
        <view class="wxpay-hint">
          <text class="hint-title">支持 一年之计 小程序</text>
          <text class="hint-desc">购买不限量提示词功能</text>
        </view>
        <view class="wxpay-features">
          <view class="feature-item">
            <text class="feature-icon">✨</text>
            <text class="feature-text">无限次刷新提示词</text>
          </view>
          <view class="feature-item">
            <text class="feature-icon">🎯</text>
            <text class="feature-text">精选拜年祝福语</text>
          </view>
          <view class="feature-item">
            <text class="feature-icon">💝</text>
            <text class="feature-text">让拜年更有心意</text>
          </view>
        </view>
      </view>
      <view class="input-card-footer">
        <button class="input-card-btn wxpay-confirm-btn" bindtap="confirmWxPay">立即购买</button>
      </view>
    </view>
  </view>

  <!-- 解锁码激活卡片遮罩和卡片 -->
  <view class="input-mask {{showUnlockCodeCard ? 'show' : ''}}" bindtap="closeUnlockCodeCard" wx:if="{{showUnlockCodeCard}}">
    <view class="input-card {{unlockCodeCardShow ? 'show' : ''}}" catchtap="stopPropagation">
      <view class="input-card-header">
        <text class="input-card-title">解锁提词器</text>
        <text class="input-card-close" bindtap="closeUnlockCodeCard">×</text>
      </view>
      <view class="input-card-body">
        <view class="unlock-code-hint">
          <text class="hint-title">支持 一年之计 小程序</text>
          <text class="hint-desc">购买不限量提示词功能</text>
        </view>
        <view class="unlock-code-features">
          <view class="feature-item">
            <text class="feature-icon">✨</text>
            <text class="feature-text">无限次刷新提示词</text>
          </view>
          <view class="feature-item">
            <text class="feature-icon">🎯</text>
            <text class="feature-text">精选拜年祝福语</text>
          </view>
          <view class="feature-item">
            <text class="feature-icon">💝</text>
            <text class="feature-text">让拜年更有心意</text>
          </view>
        </view>
        <view class="purchase-section">
          <view class="purchase-hint">
            <text class="purchase-hint-text">通过浏览器购买后，输入解锁码激活</text>
          </view>
          <button class="purchase-btn" bindtap="copyPurchaseUrl">
            <text class="purchase-btn-text">👋 复制网址 到浏览器打开</text>
          </button>
        </view>
        <view class="divider-line">
          <text class="divider-text">或输入解锁码</text>
        </view>
        <input class="input-card-input" type="text" value="{{unlockCodeValue}}" placeholder="请输入解锁码" bindinput="onUnlockCodeInputChange" bindconfirm="confirmUnlockCode" confirm-type="done" focus="{{unlockCodeFocus}}" maxlength="50" />
      </view>
      <view class="input-card-footer">
        <button class="input-card-btn" bindtap="confirmUnlockCode" loading="{{isActivating}}" disabled="{{isActivating}}">确认激活</button>
      </view>
    </view>
  </view>
</view>

