.nickname {
  width: 242rpx;
  height: 82rpx;
  padding: 0;
  margin: 0;
  border: none;
  outline: none;
  background: transparent;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
