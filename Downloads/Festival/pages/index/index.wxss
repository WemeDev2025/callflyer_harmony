  background: rgba(255, 255, 255, 0.15);
}

/* 点赞数显示 */
.like-count {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* 激活解锁码按钮 */
.unlock-btn {
  display: flex;
  align-items: center;
  border: none;
  line-height: 1;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  transition: transform 0.1s ease, background 0.1s ease;
}

.unlock-btn::after {
  border: none;
}

.unlock-icon {
  font-size: 24rpx;
  font-weight: 600;
  color: #000;
}

/* 分享按钮 */
.share-btn {
  display: flex;
  align-items: center;
  border: none;
  line-height: 1;
  transition: transform 0.1s ease, background 0.1s ease;
}

.share-btn::after {
  border: none;
}

.share-btn:active {
  transform: scale(0.95);
  background: rgba(255, 255, 255, 0.15);
}

.share-icon {
  font-size: 24rpx;
  color: #e0e0e0;
  font-weight: 500;
}

.like-icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.like-number {
  font-size: 24rpx;
  color: #e0e0e0;
  font-weight: 500;
  line-height: 1;
}

.info-content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 48rpx 44rpx;
  gap: 48rpx;
