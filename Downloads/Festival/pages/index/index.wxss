/* ========== 页面基础样式 ========== */
.page {
  padding: 20px;
  min-height: 100vh;
  background: linear-gradient(180deg, #fff7f0, #fff);
}

/* ========== 卡片样式 ========== */
.card {
  position: relative;
  padding: 20px;
  border-radius: 18px;
  overflow: hidden;
  color: #fff;
  background: linear-gradient(135deg, #FFD6A5, #FF7A7A);
  box-shadow: 0 10px 30px rgba(255, 66, 66, 0.18);
}

.header {
  text-align: center;
  margin-bottom: 18px;
}

.title {
  display: block;
  font-size: 28px;
  font-weight: 700;
}

.sub {
  display: block;
  margin-top: 6px;
  font-size: 12px;
  opacity: 0.9;
}

/* ========== 倒计时样式 ========== */
.countdown {
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 6px 0 14px;
}

/* 每个时间段使用固定宽度，避免数字变宽导致整体抖动 */
.time-seg {
  width: 72px;
  padding: 4px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.num {
  display: inline-block;
  width: 100%;
  font-size: 36px;
  font-weight: 800;
  text-align: center;
  font-family: "Menlo", "Monaco", "Courier New", monospace;
}

.label {
  margin-top: 4px;
  font-size: 12px;
  opacity: 0.95;
}

/* 冒号单独固定宽度，保持与时间块的稳定间距 */
.colon {
  width: 28px;
  margin: 0 6px;
  font-size: 28px;
  text-align: center;
  color: rgba(255, 255, 255, 0.9);
}

/* ========== 底部样式 ========== */
.footer {
  text-align: center;
  margin-top: 6px;
}

.greet {
  font-size: 14px;
  font-weight: 600;
}

/* ========== 动画效果 ========== */

/* 卡片呼吸/脉冲动画 */
.card-container.pulse .card {
  animation: cardPulse 5s ease-in-out infinite;
}

@keyframes cardPulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.015);
  }
}

/* 打字机效果 */
.greet.typewriter {
  display: inline-block;
}

.cursor {
  display: inline-block;
  margin-left: 2px;
  animation: cursorBlink 1s infinite;
}

@keyframes cursorBlink {
  0%, 50% {
    opacity: 1;
  }
  51%, 100% {
    opacity: 0;
  }
}

/* ========== 星星动画 ========== */
.sparkles {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.spark {
  position: absolute;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  opacity: 0.9;
  background: rgba(255, 255, 255, 0.9);
  transform: scale(0.9);
  animation: float 3s linear infinite;
}

@keyframes float {
  0% {
    transform: translateY(0) scale(0.6);
    opacity: 1;
  }
  100% {
    transform: translateY(-160px) scale(1.2);
    opacity: 0;
  }
}
