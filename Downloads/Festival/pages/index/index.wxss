/* ========== 页面基础样式 ========== */
.page {
  width: 100%;
  height: 100vh;
  padding: 0;
  box-sizing: border-box;
  background: #161616;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* ========== 广告图遮罩 ========== */
.ad-image-mask {
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  width: 100vw !important;
  height: 100vh !important;
  min-height: 100vh !important;
  background: rgba(0, 0, 0, 0.85) !important;
  z-index: 999999 !important;
  display: flex !important;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}

.ad-image-mask.show {
  opacity: 1 !important;
  pointer-events: auto !important;
}

.ad-image-container {
  position: relative;
  width: 90%;
  max-width: 750rpx;
  min-width: 200rpx;
  min-height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: scale(0.8);
  transition: transform 0.3s ease;
}

.ad-image-mask.show .ad-image-container {
  transform: scale(1);
}

.ad-image {
  display: block;
  /* 宽度和高度由 JS 动态设置，如果未设置则使用默认值 */
  width: auto;
  height: auto;
  max-width: 90vw; /* 最大宽度为屏幕的90% */
  max-height: 80vh; /* 最大高度为屏幕的80% */
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.5);
  background: transparent;
  object-fit: contain;
}

.ad-image-clickable {
  cursor: pointer;
}

/* ========== 页面滚动容器 ========== */
.page-scroll {
  width: 100%;
  flex: 1;
  box-sizing: border-box;
  overflow-y: auto;
  overflow-x: hidden;
  /* 隐藏滚动条 */
  scrollbar-width: none; /* Firefox */
  -ms-overflow-style: none; /* IE 10+ */
  /* 隐藏 WebKit 浏览器的滚动条 */
}

/* 隐藏 WebKit 浏览器的滚动条 */
.page-scroll::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  background: transparent;
}

/* ========== 自定义导航栏 ========== */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  background: transparent;
  box-sizing: border-box;
}

.navbar-content {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 0 20px;
}

.navbar-title {
  font-size: 18px;
  font-weight: 600;
  color: #fff;
  margin-left: 24rpx;
}

/* 导航栏歌词样式 */
.navbar-lyric {
  font-size: 16px;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.9);
  margin-left: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: calc(100vw - 80px);
  animation: navbarLyricPulse 2s ease-in-out infinite;
}

@keyframes navbarLyricPulse {
  0%, 100% {
    transform: scale(1);
    opacity: 0.85;
  }
  50% {
    transform: scale(1.03);
    opacity: 1;
  }
}

/* ========== 卡片容器 ========== */
.card-container {
  padding: 20px;
  box-sizing: border-box;
  width: 100%;
}

/* ========== 卡片样式 ========== */
.card {
  position: relative;
  padding: 32px;
  border-radius: 18px;
  overflow: visible; /* 允许粒子穿过 */
  color: #fff;
  background: linear-gradient(180deg, #ff002f 0%, #991B33 100%);
  /* 禁用点击高亮效果（Android 蓝色点击效果） */
  -webkit-tap-highlight-color: transparent;
  /* 移除彩色阴影光效 */
  box-shadow: none;
  z-index: 1; /* 设置层级 */
  cursor: pointer; /* 添加点击提示 */
  /* 图片比例 480x327（使用 aspect-ratio，包括padding） */
  width: 100%;
  aspect-ratio: 480 / 327;
  box-sizing: border-box; /* padding包含在宽度内 */
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

/* 显示图片时，移除卡片背景和阴影，但保留 padding 和尺寸 */
.card.no-background {
  background: transparent;
  box-shadow: none;
  overflow: hidden; /* 图片模式下隐藏溢出 */
}

/* 卡片内容容器，用于保持圆角裁剪 */
.card > .header,
.card > .countdown,
.card > .footer {
  position: relative;
  z-index: 10; /* 确保内容在粒子之上 */
}

/* 卡片容器内的粒子容器 */
.card-container .card-sparks {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 5; /* 在背景之上，内容之下 */
  pointer-events: none;
}

.header {
  text-align: center;
  margin-bottom: 18px;
}

.title {
  display: block;
  font-size: 28px;
  font-weight: 700;
  font-family: 'Douyin Sans', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.sub {
  display: block;
  margin-top: 6px;
  font-size: 12px;
  opacity: 0.9;
}

/* ========== 倒计时样式 ========== */
.countdown {
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 4px 0 10px; /* 减少间距以适应16:9比例 */
  width: 100%;
  box-sizing: border-box;
}

/* 每个时间段使用固定宽度，避免数字变宽导致整体抖动 */
.time-seg {
  width: 50px;
  padding: 2px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  flex-shrink: 0;
}

.num {
  display: inline-block;
  width: 100%;
  font-size: 32px;
  font-weight: 800;
  text-align: center;
  font-family: "Menlo", "Monaco", "Courier New", monospace;
}

.label {
  margin-top: 2px;
  font-size: 11px;
  opacity: 0.95;
}

/* 冒号单独固定宽度，保持与时间块的稳定间距 */
.colon {
  width: 16px;
  margin: 0 4px;
  font-size: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: flex-start;
  margin-top: 4px; /* 与 .time-seg 的 padding 对齐，使冒号与数字部分对齐 */
  height: 32px; /* 与数字高度对齐 */
  line-height: 1;
  text-align: center;
  color: rgba(255, 255, 255, 0.9);
  flex-shrink: 0;
}

/* ========== 底部样式 ========== */
.footer {
  text-align: center;
  margin-top: 4px; /* 减少间距以适应16:9比例 */
}

.greet {
  font-size: 14px;
  font-weight: 600;
}

/* ========== 动画效果 ========== */

/* 卡片呼吸/脉冲动画 */
.card-container.pulse .card {
  animation: cardPulse 5s ease-in-out infinite;
}

@keyframes cardPulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.015);
  }
}

/* 打字机效果 */
.greet.typewriter {
  display: inline-block;
}

.cursor {
  display: inline-block;
  margin-left: 2px;
  animation: cursorBlink 1s infinite;
}

@keyframes cursorBlink {
  0%, 50% {
    opacity: 1;
  }
  51%, 100% {
    opacity: 0;
  }
}

/* ========== 拜年图片容器 ========== */
.newyear-image-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  padding: 0;
  border-radius: 18px;
  overflow: hidden;
  /* 禁用点击高亮效果 */
  -webkit-tap-highlight-color: transparent;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 容器宽高可以通过 aspect-ratio 调整，或者移除让图片自适应 */
  /* aspect-ratio: 16 / 9; */ /* 如果需要固定比例，取消注释并修改比例 */
}

.newyear-image-container:active {
  opacity: 0.8;
}

.newyear-image {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 18px;
  object-fit: cover; /* 填满容器，保持宽高比，可能会裁剪 */
  /* 如果需要完整显示图片，可以改为 object-fit: contain; */
  animation: newYearImageFadeIn 0.8s ease-in-out;
}

@keyframes newYearImageFadeIn {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* ========== 星星动画 ========== */
.sparkles {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.spark {
  position: absolute;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  opacity: 0.9;
  background: rgba(255, 255, 255, 0.9);
  transform: scale(0.9);
  animation: float 3s linear infinite;
}

@keyframes float {
  0% {
    transform: translateY(0) scale(0.6);
    opacity: 1;
  }
  100% {
    transform: translateY(-160px) scale(1.2);
    opacity: 0;
  }
}


.title-profile {
  margin-top: 24rpx;
  margin-left: 60rpx;
  margin-right: 60rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx; /* 左边距离"我的" 22rpx */
}

.title-profile text {
  font-size: 17px;
  font-weight: 600;
  color: rgb(255, 255, 255);
}

/* 标题区域的VIP按钮 */

.title-unlock-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 16rpx;
  background: rgba(255, 255, 255, 0.2); /* 非VIP：灰色样式 */
  border-radius: 999rpx; /* 圆角拉满 */
  border: none;
  line-height: 1;
  height: 40rpx;
  min-width: 60rpx;
  box-sizing: border-box;
  margin-left: 0; /* 确保使用 gap 控制间距 */
}

.title-unlock-btn::after {
  border: none;
}

/* 非VIP状态：灰色样式 */
.title-unlock-btn .unlock-icon {
  font-size: 20rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.8);
}

/* VIP状态：黄色背景黑字 */
.title-unlock-btn.vip-active {
  background: #FFD700; /* 黄色背景 */
}

.title-unlock-btn.vip-active .unlock-icon {
  color: #000000; /* 黑字 */
  font-weight: 600;
}

/* ========== 歌词显示 ========== */
.lyric-container {
  padding: 20px 30px;
  margin: 20px 0;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 80rpx;
}

.lyric-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  text-align: center;
  line-height: 1.6;
  transition: opacity 0.3s ease;
  animation: lyricFadeIn 0.5s ease, lyricPulse 2s ease-in-out 0.5s infinite;
}

@keyframes lyricFadeIn {
  from {
    opacity: 0;
    transform: translateY(10rpx) scale(1);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes lyricPulse {
  0%, 100% {
    transform: translateY(0) scale(1);
    opacity: 0.85;
  }
  50% {
    transform: translateY(0) scale(1.05);
    opacity: 1;
  }
}

/* ========== 点赞列表弹窗 ========== */
.likes-list-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.7);
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}

.likes-list-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.likes-list-container {
  width: 80%;
  max-width: 600rpx;
  max-height: 70vh;
  background: #2a2a2a;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.likes-list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 40rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.likes-list-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.likes-list-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #999;
  cursor: pointer;
  line-height: 1;
}

.likes-list-close:active {
  opacity: 0.7;
}

.likes-list-content {
  flex: 1;
  padding: 20rpx 0;
  max-height: calc(70vh - 120rpx);
}

.likes-list-loading,
.likes-list-empty {
  padding: 60rpx 40rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.likes-list-item {
  display: flex;
  align-items: center;
  padding: 24rpx 40rpx;
  gap: 24rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.likes-list-item:last-child {
  border-bottom: none;
}

.likes-list-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #4a4a5a;
  flex-shrink: 0;
}

.likes-list-nickname {
  flex: 1;
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

.likes-list-time {
  font-size: 24rpx;
  color: #999;
  flex-shrink: 0;
}

/* ========== 按钮容器：还有谁 & 拜年卡片 ========== */
.action-buttons-container {
  padding: 20px 20px 40px;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  gap: 22rpx;
  justify-content: center;
}

.more-people-btn {
  width: 48%;
  height: 88rpx;
  background: linear-gradient(180deg, #ff4005 0%, #991B33 100%);
  border: none;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  transition: transform 0.12s ease, box-shadow 0.12s ease, opacity 0.12s ease;
  box-shadow: 0 8rpx 18rpx rgba(153, 27, 51, 0.45);
}

.more-people-btn::after {
  border: none;
}

.more-people-btn:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 10rpx rgba(153, 27, 51, 0.45);
  opacity: 0.92;
}

.more-people-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

/* ========== 新增信息卡片 ========== */
.info-card-container {
  padding: 0 20px;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
}

.info-card {
  position: relative;
  width: 730rpx;
  min-height: 506rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: #202020;
  box-shadow: 0px 4rpx 16rpx rgba(0, 0, 0, 0.3);
  border-radius: 44rpx;
  overflow: hidden;
}

/* 按钮组 */
.card-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-left: auto;
  flex-shrink: 0;
}

/* 按钮通用样式 */
.card-action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 27rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 66rpx;
  height: 66rpx;
