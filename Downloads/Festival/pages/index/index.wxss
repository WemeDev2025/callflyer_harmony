}

.btn-orange {
  width: 132rpx;
  height: 66rpx;
  background: #FBC34C;
}

.btn-blue {
  width: 142rpx;
  height: 66rpx;
  background: #5faaff;
}

.btn-green {
  width: 132rpx;
  height: 66rpx;
  background: #6aeb6e;
}

.btn-purple {
  min-width: 132rpx;
  height: 66rpx;
  padding: 0 16rpx;
  background: #3cd8d0;
}

.btn-pink {
  min-width: 188rpx;
  height: 66rpx;
  padding: 0 16rpx;
  background: #ff5fba;
}

.btn-cyan {
  min-width: 132rpx;
  height: 66rpx;
  padding: 0 16rpx;
  background: #00d4ff;
}

.btn-text {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  font-weight: 700;
  font-size: 24rpx;
  line-height: 170%;
  color: #000000;
}

/* ========== 输入卡片样式 ========== */
.input-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  background: rgba(0, 0, 0, 0);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: background 0.3s ease, opacity 0.3s ease;
  pointer-events: none;
}

.input-mask.show {
  background: rgba(0, 0, 0, 0.75);
  opacity: 1;
  pointer-events: auto;
}

.input-card {
  width: 600rpx;
  background: #2a2a3a;
  border-radius: 24rpx;
  overflow: hidden;
  transform: scale(0.8) translateY(50rpx);
  opacity: 0;
  transition: transform 0.3s ease, opacity 0.3s ease;
}

.input-card.show {
  transform: scale(1) translateY(0);
  opacity: 1;
}

.input-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #3a3a4a;
}

.input-card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.input-card-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  line-height: 1;
  color: #999999;
  cursor: pointer;
}

.input-card-body {
  padding: 32rpx;
}

.input-card-textarea {
  width: 100%;
  min-height: 100rpx;
  padding: 20rpx;
  border: 1rpx solid #3a3a4a;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #e0e0e0;
  background: #1a1a2a;
  box-sizing: border-box;
}

.input-card-footer {
  padding: 24rpx 32rpx 32rpx;
  display: flex;
  justify-content: flex-end;
}

.input-card-btn {
  padding: 16rpx 48rpx;
  background: #FBC34C;
  border-radius: 12rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 600;
  color: #000000;
  line-height: 1;
}

.input-card-btn::after {
  border: none;
}
